        lines {
          text: "            row(90.dp)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        rowGap(16.dp)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
