          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "3. **Week 3**: Create `GeminiAutomationOrchestrator.dart`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "   - Feed screen data to Gemini Nano"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "   - Execute decisions via ScreenAutomationService"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "4. **Week 4**: Integration testing"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "   - Test on real devices"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "   - Verify Gemini reasoning with visual feedback"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
