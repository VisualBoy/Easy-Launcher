steps {
  type: CORTEX_STEP_TYPE_FILE_CHANGE
  status: CORTEX_STEP_STATUS_DONE
  metadata {
    created_at {
      seconds: 1788915670
      nanos: 809183000
    }
    source: CORTEX_STEP_SOURCE_USER_EXPLICIT
    completed_at {
      seconds: 1788915670
      nanos: 809183000
    }
  }
  file_change {
    absolute_path_uri: "file:///.agents/skills/r8-analyzer/references/KEEP-RULES-IMPACT-HIERARCHY.md"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    diff {
      unified_diff {
        lines {
          text: "Keep rules prevent optimization of R8, these rules are listed in the order of"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "the scope of what it retains in the codebase."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## 1. Package-Wide Wildcards"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "The following types of keep rules prevents all the optimization of R8 in a"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "package, these must be avoided at any costs and must be refined to target a"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "specific class or classes."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    -keep class com.example.package.** { *; } - Prevents optimization of all the classess including members in the package and subpackages"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    -keep class com.example.package.* { *; } - Prevents optimization of all the classes including members in the package"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    -keep class **.package.** { *; } - Prevents optimization of all the classess including members in all the package containing name - package."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Depending on the package level the number of classes gets affected changes, so"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "if the package level is higher, more classes are affected. Suggest to refine"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "the keep rule"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## 2. Inversion operator"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Avoid using the inversion operator ! in keep rules because it will"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "unintentionally prevent optimization in every class in your application. So if"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "you have any keep rule with !operator, make sure you remove that with a narrow"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "and specific keep rule"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    -keep class !com.example.MyClass{*;}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "This keeps the entire app"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "other than this class. Optimization are disabled for the entire class other"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "than this class."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## 3. Keep Rules for both class and members"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Keep rules with -keep option and wildcard(`*`) inside braces forces R8 to retain"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "specific classes and their members exactly as defined. These type of keep rules"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "prevent any optimization in the entire class and keeps the entire class"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    -keep class com.example.MyClass { *; }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## 4. Keepclassmembers"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Keep rules with -keepclassmembers and wildcard(`*`) inside braces option Forces"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "R8 to retain the members that are defined."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    -keepclassmembers class com.example.MyClass { *; }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## 5. Modifiers with Keep Specification"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "-Keeps the class and **all** members, but uses modifiers to allow specific"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "optimizations (like obfuscation). Retains significant code (members) but allows"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "some flexibility."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    -keep,allowobfuscation class com.example.MyClass { *; }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    -keep,allowshrinking class com.example.MyClass { *; }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### 6. Modifiers with specific method but no modifier"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Keeps the class and modifier but no optimizations are enabled"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    -keep class com.example.MyClass { void myMethod(); }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## 7. Class-Name Only Preservation"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Keeps only the class name. R8 will remove all methods and fields if they are not"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "used."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    -keep class com.example.MyClass"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## 8. Modifiers without Member Specification"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Keeps the class entry point using modifiers, but implies no specific member"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "retention logic in the rule itself"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    -keep,allowobfuscation class com.example.MyClass"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    -keep,allowshrinking class com.example.MyClass"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    -keep,allowaccessmodification class com.example.MyClass"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## 9. Conditional Keep Rules"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Only triggers if specific conditions are met (e.g., if class members exist)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "These are the most narrow and optimization-friendly rules."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    -keepclassmembers class com.example.MyClass { <fields>; }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    -keepclasseswithmembers class * { native <methods>; }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
      }
    }
  }
}
steps {
  type: CORTEX_STEP_TYPE_FILE_CHANGE
  status: CORTEX_STEP_STATUS_DONE
  metadata {
    created_at {
      seconds: 1788915670
      nanos: 809183000
    }
    source: CORTEX_STEP_SOURCE_USER_EXPLICIT
    completed_at {
      seconds: 1788915670
      nanos: 809183000
    }
  }
  file_change {
    absolute_path_uri: "file:///.agents/skills/r8-analyzer/references/REDUNDANT-RULES.md"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    diff {
      unified_diff {
        lines {
          text: "This document outlines common \"bad\" or redundant keep rules for standard Android"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "development and popular libraries. Modern toolchains and libraries include their"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "own consumer keep rules embedded in their AAR/JAR files, making many manual"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "configurations unnecessary or even harmful to code optimization."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "*** ** * ** ***"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Case: Global Keep Rules"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "**Common Mistakes:**"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`proguard"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "-dontshrink"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "-dontobfuscate"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "-dontoptimize`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "**The Fix:** These keep rules completely disable the core optimizations of R8"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "for the entire codebase. They must be removed from the codebase."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "*** ** * ** ***"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Case: Android Components"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Keep rules required for Android components like Activity, Fragment, ViewModel,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Views, Services or Broadcast receivers are redundant. AAPT2 and R8 contain the"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "logic to automatically keep components declared in the `AndroidManifest.xml` or"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "referenced in XML layout files."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "**Common Mistakes:**"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`proguard"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "-keep public class * extends android.app.Activity"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "-keep public class * extends android.app.Service"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "-keep public class * extends android.view.View"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "-keepclassmembers class * extends android.app.Fragment { public void *(android.view.View); }`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "**The Fix:** Delete these manual rules. AAPT2 handles this automatically."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "*** ** * ** ***"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Case: Official Android and Kotlin Libraries"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Keep rules targeting official library packages like AndroidX, Kotlin, and"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Kotlinx are redundant as they are bundled within the libraries themselves."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Manual rules are often broader than what is strictly needed."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "**Common Mistakes:**"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`proguard"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "-keep class androidx.** { *; }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "-keep class kotlinx.** { *; }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "-keep class kotlin.** { *; }`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "**The Fix:** Delete these manual rules. Rely on the consumer keep rules packaged"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "within these dependencies."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "*** ** * ** ***"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Case: Gson"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Overly Broad Data Model Rules"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "The most common mistake is keeping entire packages of data models (POJOs/DTOs),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "keeping data models at all for deserialization is unnecessary."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    -keep class com.example.app.models.** { *; }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    -keep class com.example.app.package.models.* { *; }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Redundant Interface \\& Adapter Rules"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "These rules added for TypeAdapter are unnecessary and are already covered by"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "the library, and prevent R8 from effectively shrinking and optimizing custom"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "adapters. R8 can determine if the adapter implementation are used. Keeping them"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "globally prevents the removal of unused adapter implementations."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    -keep class * extends com.google.gson.TypeAdapter"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    -keep class * implements com.google.gson.TypeAdapterFactory"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    -keep class * implements com.google.gson.JsonSerializer"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    -keep class * implements com.google.gson.JsonDeserializer"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Unnecessary TypeToken Rules"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "There is no need to handle generic type erasure, Gson\'s own rules handle the"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "necessary `TypeToken` preservation."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    -keep class com.google.gson.reflect.TypeToken { *; }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    -keep class * extends com.google.gson.reflect.TypeToken"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    -keep,allowobfuscation,allowshrinking class com.google.gson.reflect.TypeToken"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Internal and Example Packages"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Keeping internal library logic prevents the compiler from stripping away dead"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "code within the library."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    -keep class com.google.gson.internal.** { *; }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    -keep class com.google.gson.internal.reflect.** { *; }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    -keep class com.google.gson.internal.UnsafeAllocator { *; }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    -keep class com.google.gson.stream.** { *; }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Keeps Unused Code:** Prevents R8 from removing models that are never actually used in the code."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Prevents Method Stripping:** Keeps all getters, setters, `toString()`, `equals()`, and `hashCode()` methods, even if they are never called."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Blocks Obfuscation:** Prevents the class names from being obfuscated, which is unnecessary for Gson if you use `@SerializedName`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "**The Fix:**"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "1. Use `@SerializedName` on every field in your data classes uses so that the field is retained after R8 optimization"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "2. Modern Gson (**v2.11.0+** ) bundles its own rules ([View Gson\'s embedded"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "   ProGuard"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "   rules](https://github.com/google/gson/blob/main/gson/src/main/resources/META-INF/proguard/gson.pro)). The bundled keep rules retains the `@SerializedName` annotated fields. If you are on an older version, move towards Gson version 2.11 because it has the necessary keep rules and delete the keep rules that target the classes used for gson serialization and deserialization"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "*** ** * ** ***"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Case: Retrofit"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Retrofit has shipped with its own consumer keep rules from 2.9.0 and higher, so"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "any keep rules for the library or classes depending on Retrofit is detrimental"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "to the optimization process."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Blanket Library Preservation"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "This is the most harmful Retrofit rule as it disables any shrinking for the"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "entire library."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    -keep class retrofit2.** { *; }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    -keep class retrofit2.api.** { *; }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    -keep class com.package.example.retrofit.api.** { *; }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Manual Annotation Keeps"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Retrofit\'s consumer rules automatically keep the interfaces annotated with"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`@GET`, `@POST`, `@DELETE`, `@PUT`, `@HEAD`, `@OPTIONS`, `@PATCH`, making these"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "manual rules obsolete."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`-keepclasseswithmembers class * { @retrofit2.http.* <methods>; }`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Redundant Network Response and Adapter Rules"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Network responses and third-party adapter wrappers (like RxJava) are often"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "overly preserved by developers out of caution."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    -keep,allowobfuscation,allowshrinking class retrofit2.Response"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    -keep class retrofit2.adapter.rxjava2.Result { *; }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Fix: Verify you are using Retrofit 2.9.0 and higher. Retrofit from 2.9.0 bundles"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "rules that detect its own HTTP annotations (@GET, @POST) ([View Retrofit\'s"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "embedded ProGuard"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "rules](https://github.com/square/retrofit/blob/master/retrofit/src/main/resources/META-INF/proguard/retrofit2.pro))."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "It will automatically keep the method signatures it needs to work."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "*** ** * ** ***"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Case: Kotlin Coroutines"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Kotlin Coroutines comes heavily optimized out of the box with embedded R8 rules"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "(`kotlinx-coroutines-core` includes its own rules)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Blanket Coroutine Library Rules"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Keeping everything under `kotlinx.coroutines` is extremely detrimental to app"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "size, as coroutines contain a vast amount of internal APIs that aren\'t used."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`-keepclassmembers class kotlinx.coroutines.** { *; }`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Redundant Internal Continuations"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "These low-level coroutine elements are preserved safely by the library\'s own"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "consumer rules. Manually adding these prevents R8 from performing internal"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "optimizations (such as removing unused continuations or inlining)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    -keepclassmembers class kotlin.coroutines.SafeContinuation { *; }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    -keep,allowobfuscation,allowshrinking class kotlin.coroutines.Continuation"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Dispatcher and Exception Handler Rules"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Sometimes developers notice crashes related to Missing Classes on old Android"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "versions and add these rules, but if you are using an up-to-date version of"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Coroutines, these are handled automatically or are not an issue."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    -keepnames class kotlinx.coroutines.internal.MainDispatcherFactory {}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    -keepnames class kotlinx.coroutines.CoroutineExceptionHandler {}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    -keepnames class kotlinx.coroutines.android.AndroidExceptionPreHandler {}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    -keepnames class kotlinx.coroutines.android.AndroidDispatcherFactory {}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "**Fix** Remove any broad `kotlinx` keep rules. Coroutines (**v1.7.0+** ) bundle"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "the necessary keep rules ([View Coroutines\' embedded ProGuard"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "rules](https://github.com/Kotlin/kotlinx.coroutines/blob/master/kotlinx-coroutines-core/jvm/resources/META-INF/proguard/coroutines.pro))."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "*** ** * ** ***"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Case: Parcelable"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "**Common Mistakes:** Legacy projects often contain `-keep class * implements"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "android.os.Parcelable { public static final android.os.Parcelable$Creator *; }`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "**The Fix:**"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "1. Add the `kotlin-parcelize` plugin."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "2. **Use `@Parcelize`:** Replace manual `writeToParcel` logic with the `@Parcelize` annotation."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "3. **Delete All Parcelable Rules:** The plugin automatically generates the required rules."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "4. The default proguard file `proguard-android-optimize.txt` contains the keep rules for keeping all the parcelable classes"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "5. **Ideal Rule:** **None.** Delete all manual Parcelable keeps."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "*** ** * ** ***"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Case: Room Database"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "**Common Mistakes:** Keeping DAO interfaces or the generated `_Impl` classes"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "manually."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    -keep class * extends androidx.room.RoomDatabase"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    -keep class *_*Impl { *; }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "**The Fix:** Room generates its own ProGuard rules for the code it creates."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Manual rules are redundant and prevent R8 from optimizing the database access"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "layers."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Ideal Rule:** **None.** Delete all manual Room or DAO keeps."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "*** ** * ** ***"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Summary"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "If you have updated your libraries to the versions mentioned, your"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`proguard-rules.pro` must not contain any keep rules for the libraries"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "mentioned here."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
      }
    }
  }
}
