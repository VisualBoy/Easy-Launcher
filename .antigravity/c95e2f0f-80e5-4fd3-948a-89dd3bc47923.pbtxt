          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "   2. Add them to your module-level `build.gradle.kts` file:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          dependencies {"
