        }
        lines {
          text: "    "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    for (var i = session.messages.length - messageCount;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "         i < session.messages.length;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
