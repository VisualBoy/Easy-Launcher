    diff {
      unified_diff {
        lines {
          text: "# \360\237\223\213 Changelog \342\200\224 Easy Launcher"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Tutte le modifiche rilevanti a questo progetto sono documentate in questo file."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Il formato \303\250 basato su [Keep a Changelog](https://keepachangelog.com/it/1.0.0/) e aderisce al [Semantic Versioning](https://semver.org/lang/it/)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "---"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## [Unreleased]"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### In programma (Roadmap)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Supporto avanzato a modelli On-Device Gemini Nano tramite ML Kit for Android e Gemini Nano e AICore per risposte NLU istantanee a zero latenza."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Riconoscimento e lettura automatica di ricette mediche e referti tramite ML Kit Digital Ink Recognition & Text Recognition."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Integrazione promemoria assunzione farmaci con allarmi vocali ad alto volume."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### \360\237\247\260 Customizations & Dev Skills (Antigravity Agents)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Integrazione della suite ufficiale di 12 Android Skills di Google nel workspace (`.agents/skills/`):"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - `ml-kit-genai-prompt-api`: On-device Gemini Nano, Prefix Caching e Structured Output (@Generable)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - `edge-to-edge`: Supporto schermo intero edge-to-edge per Android 15/16 e gestione insets IME/system bars."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - `adaptive`: Layout reattivi per tablet, foldables e monitor esterni."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - `android-cli`: Toolchain da riga di comando per testing, build ed emulazione Android."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - `appfunctions`: Integrazione AppFunctions per esporre azioni ad assistenti AI on-device."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - `navigation-event`: Gestione unificata eventi di navigazione e Predictive Back."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - `navigation-3`: Architettura scene-based e Type-Safe per Jetpack Navigation 3."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - `android-intent-security`: Hardening e audit di sicurezza per intent, PendingIntent e broadcast sensibili."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - `camerax`: Pipeline fotocamera e analisi immagini con CameraX."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - `styles`: Token semantici e design system styling accessibile per Jetpack Compose."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - `testing-setup`: Infrastruttura di test screenshot (Roborazzi) e unit/UI test."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - `r8-analyzer`: Analisi e ottimizzazione regole keep e configurazioni ProGuard/R8."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "---"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## [1.0.0] - 2026-09-08"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### \360\237\216\211 Release Iniziale \342\200\224 Easy Launcher"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Prima versione completa di **Easy Launcher**, il launcher Android accessibile progettato per anziani, persone allettate e utenti con disabilit\303\240 motorie o visive, sviluppato da **GlitchLab Studio**."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### \342\234\250 Added (Funzionalit\303\240 Aggiunte)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "#### \360\237\226\245\357\270\217 Interfaccia Utente & Accessibilit\303\240 (Jetpack Compose M3)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Schermata Home Tattile ad Alto Contrasto**:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - Orologio digitale a caratteri giganti con data in italiano e ombreggiatura profonda anti-riflesso."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - Barra di stato semplificata con indicatore batteria ad alta visibilit\303\240 e segnale cellulare."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - Banner riassuntivo notifiche e chiamate perse con badge colorati."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - **6 Card Tattili Extra-Large**:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    - \360\237\223\236 **Telefono**: Rubrica rapida con contatti di emergenza e chiamate dirette a un tocco."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    - \360\237\222\254 **Messaggi / WhatsApp**: Accesso rapido alle conversazioni e alle notifiche in sospeso."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    - \360\237\224\246 **Torcia / Luce**: Controllo istantaneo flash con feedback visivo dinamico e animazione luminosa."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    - \360\237\223\267 **Fotocamera / Foto**: Apertura diretta della fotocamera di sistema."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    - \342\232\231\357\270\217 **Impostazioni**: Configurazione semplificata (accessibilit\303\240, sintesi vocale, contatti SOS)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    - \360\237\232\250 **SOS / Soccorsi**: Attivazione immediata della sequenza di emergenza salvavita."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Pulsante Assistente Vocale Fisso**:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - Pillola inferiore con bordo animato ciano neon (`NeonCyanGlow`) e pulsante microfono da 56dp per un facile accesso motorio."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - Overlay a tutto schermo con visualizzazione stato in tempo reale (Ascolto, Elaborazione, Esecuzione Tool, Risposta)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - Feedback sonoro e indicatore di intensit\303\240 vocale RMS."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "#### \360\237\247\240 Intelligenza Artificiale & Orchestrazione NLU (Gemini API & Tool Calling)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **`GeminiAssistantManager`**:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - Integrazione nativa con **Gemini 2.5 Flash** via Google AI Generative Language API."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - Motore di **Function Calling / Tool Calling** a turni multipli per tradurre il linguaggio naturale in azioni Android native."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - **Dichiarazioni Tool Supportate**:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    - `send_sms`: Invio di SMS con destinatario e testo estratti dal comando vocale."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    - `send_whatsapp`: Invio di messaggi WhatsApp diretti."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    - `trigger_emergency_sos`: Attivazione allarme SOS con trasmissione GPS."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    - `toggle_torch`: Accensione e spegnimento del flash LED."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    - `make_phone_call`: Avvio di telefonate verso contatti specifici."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    - `read_notifications`: Lettura vocale delle notifiche recenti."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    - `open_app`: Avvio rapido di qualsiasi applicazione installata."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    - `get_device_status`: Lettura di orario, data, percentuale batteria e stato torcia."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Motore Euristico Locale Offline**:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - Fallback intelligente a regole locali per garantire l\'esecuzione dei comandi vitali (SOS, Chiamate, Torcia, SMS, WhatsApp) **anche in totale assenza di connessione internet** o in modalit\303\240 aereo."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "#### \360\237\232\250 Sistema di Emergenza SOS Multi-Livello"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **`SosManager` & Sequenza Salvavita**:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - Conto alla rovescia di 5 secondi annullabile con segnale acustico d\'allarme (`ToneGenerator`)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - Modalit\303\240 vocale immediata per situazioni di panico o caduta."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **`SosEmergencyForegroundService`**:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - Registrazione audio ambientale di emergenza di 10 secondi."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - Trascrizione vocale contestuale dell\'accaduto."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - Geolocalizzazione ad alta precisione tramite Google Play Services `FusedLocationProviderClient` (`Priority.PRIORITY_HIGH_ACCURACY`)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - Generazione link Google Maps con coordinate esatte."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - Spedizione automatica multicanale (SMS e WhatsApp) del messaggio di soccorso con testo, coordinate e registrazione audio ai contatti designati."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "#### \360\237\221\201\357\270\217 Servizi di Accessibilit\303\240 & Automazione WhatsApp"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **`WhatsAppNotificationService` (`NotificationListenerService`)**:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - Intercettazione in tempo reale di notifiche in arrivo (WhatsApp, WhatsApp Business, SMS, Telegram, Telefono)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - Gestione risposte rapide senza aprire l\'applicazione tramite `RemoteInput` inline bundle."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - Rilevamento automatico e conteggio chiamate perse e messaggi non letti."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **`WhatsAppAccessibilityFallbackService` (`AccessibilityService`)**:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - Automazione sicura della UI per l\'invio di messaggi WhatsApp quando le API standard o le notifiche dirette non sono disponibili."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - Riconoscimento dei campi di input e pulsanti di invio tramite View ID, gerarchia nodi e OCR."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - Supporto per azioni globali di sistema (Home, Indietro, Notifiche) a supporto di utenti con disabilit\303\240 motorie gravi."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "#### \360\237\224\212 Audio & Sintesi Vocale"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **`TtsManager`**:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - Sintesi vocale italiana (Text-To-Speech) configurabile per conferme vocali chiare, rassicuranti e ad alto volume."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - Lettura vocale automatica di messaggi e notifiche."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Speech Recognition Android**:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - Riconoscimento vocale continuo e reattivo con gestione permessi dinamica in Jetpack Compose."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "#### \342\232\231\357\270\217 CI/CD & Build Automation"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **GitHub Actions Workflow (`.github/workflows/build-apk.yml`)**:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - Compilazione automatica APK di debug su push sul branch `main` e trigger manuale `workflow_dispatch`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - Ambiente Ubuntu con Java 17 Temurin, Gradle 9.3.1 e Android Gradle Plugin 9.1.1."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - Generazione automatica keystore di debug per packaging APK consistente."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - Archiviazione artefatto `app-debug-apk`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - Pubblicazione automatica della release GitHub tramite `gh release create` con tag univoco per download immediato su smartphone."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "---"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## [0.1.0] - 2026-09-07"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### \360\237\217\227\357\270\217 Setup Iniziale e Prototipazione"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Creazione della struttura di base del progetto Android con Gradle Kotlin DSL (`build.gradle.kts`)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Configurazione del Version Catalog (`gradle/libs.versions.toml`) con AGP 9.1.1, Kotlin 2.2.10 e Jetpack Compose BOM."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Implementazione del tema accessibile ad alto contrasto (`Color.kt`, `Theme.kt`, `Type.kt`)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Impostazione dei permessi di sistema in `AndroidManifest.xml` (`RECORD_AUDIO`, `CALL_PHONE`, `SEND_SMS`, `ACCESS_FINE_LOCATION`, `CAMERA`, `BIND_ACCESSIBILITY_SERVICE`, `BIND_NOTIFICATION_LISTENER_SERVICE`)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
      }
    }
  }
}
