          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "val LocalExtendedColors = staticCompositionLocalOf {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    ExtendedColors("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        caution = Color.Unspecified,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
