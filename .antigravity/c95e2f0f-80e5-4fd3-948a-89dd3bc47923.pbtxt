          text: "   Compose artifact:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "       [versions]"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "       navigationevent = \"1.0.0\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
