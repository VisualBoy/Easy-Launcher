    file_change_type: FILE_CHANGE_TYPE_CREATE
    diff {
      unified_diff {
        lines {
          text: "While the `Grid` config defines the overall structure,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "you use the [`gridItem`](https://developer.android.com/reference/kotlin/androidx/compose/foundation/layout/GridScope#(androidx.compose.ui.Modifier).gridItem(kotlin.Int,kotlin.Int,kotlin.Int,kotlin.Int,androidx.compose.ui.Alignment)) modifier to control the position, spanning,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "and alignment of items within that structure."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Set the item position"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Place an item into a specific track or cell"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "with the `row` and `column` parameters."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Coordinate indexes work best for straightforward grid layouts."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "For larger or more complex layouts, define [named areas](https://developer.android.com/develop/ui/compose/layouts/adaptive/grid/container-properties#named-area) instead."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "The `row` and `column` parameters specify the row and column track indexes"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "that the item is placed in."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Track indexes are 1-based---they start at one."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Specifying only `row` or `column` (not both) places the item"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "in the next available space in that track."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Specifying both places the item into that cell."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Use a positive integer to specify the track index from the start."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "For example, to place an item in the first row and column,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "use `gridItem(row = 1, column = 1)`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Use a negative integer to specify the track relative to the end."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "For example, to place an item in the second-to-last row and column, use"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`gridItem(row = -2, column = -2)`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "In the following example, Card **#2** is placed"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "in the second row and the second column."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Card **#3** is assigned to the last row (indexed by -1),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "where it automatically occupies"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "the first available column in that track (Figure 1)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
