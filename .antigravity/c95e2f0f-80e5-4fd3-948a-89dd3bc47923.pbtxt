          text: "# Two-Pane Scene Recipe"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "This example shows how to create a two pane layout using the Scenes API."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "A `TwoPaneSceneStrategy` will return a `TwoPaneScene` if:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- the window width is over 600dp"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- the last two nav entries on the back stack have indicated that they support being displayed in a `TwoPaneScene` in their metadata."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
