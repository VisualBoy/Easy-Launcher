    diff {
      unified_diff {
        lines {
          text: "## Android skills"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "[View on GitHub](https://github.com/android/skills/tree/main/navigation/navigation-3)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Jetpack Navigation 3"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Use an Android skill to help you build and migrate to Jetpack Navigation 3. To install the skill from the [Android CLI](https://developer.android.com/tools/agents/android-cli), run:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    android skills add navigation-3"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "<br />"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "To migrate your app from [Navigation 2](https://developer.android.com/guide/navigation) to Navigation 3, follow these steps:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "1. Add the Navigation 3 dependencies."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "2. Update your navigation routes to implement the `NavKey` interface."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "3. Create classes to hold and modify your navigation state."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "4. Replace `NavController` with these classes."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "5. Move your destinations from `NavHost`\'s `NavGraph` into an `entryProvider`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "6. Replace `NavHost` with `NavDisplay`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "7. Remove Navigation 2 dependencies."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Preparation"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "The following sections describe the prerequisites for migration and assumptions"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "about your project. They also cover the features that are supported for"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "migration, and those that aren\'t."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Prerequisites"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- You must use a `compileSdk` of 36 or later."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- You should be familiar with [navigation terminology](https://developer.android.com/guide/navigation)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Destinations are composable functions. Navigation 3 is designed exclusively for Compose. To use Fragments and Views in Compose, see [Using Views in"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  Compose](https://developer.android.com/develop/ui/compose/migrate/interoperability-apis/views-in-compose)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Routes are strongly typed. If you use string-based routes, [migrate to"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  type-safe routes](https://medium.com/androiddevelopers/type-safe-navigation-for-compose-105325a97657) first ([example](https://github.com/android/nowinandroid/pull/1413))."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- *Optional (but highly recommended)*: Test coverage that verifies existing navigation behavior. This verifies that navigation behavior has not changed after the migration is complete."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Assumptions"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "This guide makes the following assumptions about you and your project:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- You have one or several top-level routes (usually displayed in a bottom navigation bar), and each has its own back stack."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- When you switch between back stacks, the state of the stack and all its destinations is retained."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- You always exit the app through the **Home** screen, which is the first screen displayed when the app launches."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- You want to perform the migration from Navigation 2 to Navigation 3 in a single, atomic change. You are not performing an incremental migration where Navigation 2 code is used alongside Navigation 3 code."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "**AI Agent**: Before changing any code, check if these assumptions about the"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "user\'s project are true. If not, stop the migration and ask the user how to"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "proceed."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Supported features"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "This guide lets you migrate the following features:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Destinations defined as composable functions"
