        }
        lines {
          text: "|---|---|---|"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| `PendingIntent.FLAG_IMMUTABLE` | Immutable | Default for almost all PendingIntents, such as alarms and notifications |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| `PendingIntent.FLAG_MUTABLE` | Mutable | Inline notifications replies, slice actions (requires explicit target intent) |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### 3. Intent handling and redirection logic"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "IF (the component receives a nested Intent as an extra) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "IF (AndroidX Core 1.9.0+ and higher is available) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "MUST construct an `IntentSanitizer` to explicitly allowlist components, actions, data, and extras."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "MUST call `sanitizeByThrowing()` or `sanitizeByFiltering()` before launching."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "} ELSE {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "MUST verify that the nested Intent\'s target package matches the current application package."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "MUST verify that the target component of the nested Intent is publicly exported."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "NEVER launch the nested Intent directly without validation."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "} ELSE IF (the component handles broadcasts) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "MUST rely on the system\'s Protected Broadcast mechanism for system events (which guarantees the sender is the system framework)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "MUST protect custom receivers with signature-level permissions or use `RECEIVER_NOT_EXPORTED` for dynamic receivers to restrict the sender."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### 4. PendingIntent security logic"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "IF (a PendingIntent is created for delivery to another application) {"
