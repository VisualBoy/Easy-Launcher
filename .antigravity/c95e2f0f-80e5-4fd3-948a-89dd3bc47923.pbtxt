          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "1. Build the project. Verify that there are no compilation errors."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
