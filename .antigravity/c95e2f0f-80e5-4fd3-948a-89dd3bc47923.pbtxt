        lines {
          text: "# List-Detail Scene Recipe"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "This example shows how to create a list-detail layout using the Scenes API."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "A `ListDetailSceneStrategy` will return a `ListDetailScene` if:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- the window width is over 600dp"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- A `Detail` entry is the last item in the back stack"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- A `List` entry is in the back stack"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "The `ListDetailScene` provides a `CompositionLocal` named `LocalBackButtonVisibility` that can be used by the detail `NavEntry` to control whether it displays a back button. This is useful when the detail entry usually displays a back button but should not display it when being displayed in a `ListDetailScene`. See <https://github.com/android/nav3-recipes/issues/151> for more details on this use case."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "See `ListDetailScene.kt` for more implementation details."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
