          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "           contentColor(colors.textPrimary)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "       }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "   }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
