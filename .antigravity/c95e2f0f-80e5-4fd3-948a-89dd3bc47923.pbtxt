  file_change {
    absolute_path_uri: "file:///.agents/skills/ml-kit-genai-prompt-api/references/prompt-optimization.md"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    diff {
      unified_diff {
        lines {
          text: "This skill provides guidance on how to optimize prompts for use with the ML Kit Prompt API."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Guidelines & Rules"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Apply these core rules:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Include examples for in-context learning:** Include examples of the desired model output."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Make prompts concise:** Remove duplicate or repeated instructions. Do not include conversational filler such as hello, please, do this, help me with, etc."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Use paired XML/HTML delimiters:** Denote dynamic inputs (for example `<email>[content]</email>`) to clearly isolate user data from prompt instructions."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Use the Structured Output API:** If the output requires parsing responses into certain formats, use Structured Output API. Return the `@Generable` typed object from the function signature instead of a string or JSON string."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Keep output short:** Add output constraints such as word count, character count, or bullet limits."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Use system instructions:** For short instructions that define how a model should behave, and use prefix caching for prompts over 200 words."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
      }
    }
  }
}
