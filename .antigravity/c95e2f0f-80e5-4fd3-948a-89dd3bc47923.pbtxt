  file_change {
    absolute_path_uri: "file:///.agents/skills/adaptive/references/android/develop/ui/compose/layouts/adaptive/flexbox/item-behavior.md"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    diff {
      unified_diff {
        lines {
          text: "Use `Modifier.flex` to control how an item changes size, order, and is aligned"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "inside a `FlexBox`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Item size"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Use the `basis`, `grow`, and `shrink` functions to control an item\'s size."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```kotlin"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "FlexBox {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    RedRoundedBox("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        modifier = Modifier.flex {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            basis(FlexBasis.Auto)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            grow(1.0f)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            shrink(0.5f)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    )"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "<br />"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Set initial size"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Use `basis` to specify the item\'s initial size before any extra space is"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "distributed. You can think of this as the item\'s *preferred* size."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "|---|---|---|---|"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| **Value type** | **Behavior** | **Code snippet** Note: The boxes have a maximum intrinsic size of `100dp` | **Example using container width `600dp`** |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| `Auto` (default) | Use the item\'s maximum intrinsic size. For example, a `Text` composable\'s maximum intrinsic width is the width of all its text on a single line - no wrapping. | ```kotlin FlexBox { RedRoundedBox( Modifier.flex { basis(FlexBasis.Auto) } ) BlueRoundedBox( Modifier.flex { basis(FlexBasis.Auto) } ) } ``` | ![Items sized based on their intrinsic size using basis Auto.](https://developer.android.com/static/develop/ui/compose/images/layouts/adaptive/flexbox/initialsize-1.png) |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| Fixed `dp` | A fixed size in Dp. | ```kotlin FlexBox { RedRoundedBox( Modifier.flex { basis(200.dp) } ) BlueRoundedBox( Modifier.flex { basis(100.dp) } ) } ``` | ![Items sized to a fixed dp value using basis.](https://developer.android.com/static/develop/ui/compose/images/layouts/adaptive/flexbox/initialsize-2.png) |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| Percentage | A percentage of the container size. | ```kotlin FlexBox { RedRoundedBox( Modifier.flex { basis(0.7f) } ) BlueRoundedBox( Modifier.flex { basis(0.3f) } ) } ``` | ![Items sized as a percentage of container size using basis.](https://developer.android.com/static/develop/ui/compose/images/layouts/adaptive/flexbox/initialsize-3.png) |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "If the basis value is less than the item\'s intrinsic minimum size, the intrinsic"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "minimum size is used instead. For example, if a `Text` item that contains a word"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "requires `50dp` to display, but also has `basis = 10.dp`, a"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "value of `50dp` is used."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Grow items when there\'s space"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Use `grow` to specify how much an item grows when there is extra space. This is"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "space remaining in the `FlexBox` container after all the items\' `basis` values"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "have been added up. The `grow` value indicates *how much* of the extra space a"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "given child will receive, relative to its siblings. By default, items won\'t"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "grow."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "The following example shows a `FlexBox` with three child items. Each has a basis"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "value of `100dp`. The first child has a positive `grow` value. Since there is"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "only one child with a `grow` value, the actual value is irrelevant - as long as"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "it\'s positive, the child receives all the extra space."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "The images show the `FlexBox` behavior when its container size is `600dp`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "|---|---|"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| ```kotlin FlexBox { RedRoundedBox( title = \"400dp\", modifier = Modifier.flex { grow(1f) } ) BlueRoundedBox(title = \"100dp\") GreenRoundedBox(title = \"100dp\") } ``` | Each child has a basis value of `100dp`. There is `300dp` of extra space. ![Three items with 100dp basis each, in a 600dp container, before growth.](https://developer.android.com/static/develop/ui/compose/images/layouts/adaptive/flexbox/growitems-1.png) Child 1 grows by `300dp` to fill the extra space. ![First item grows to fill 300dp of extra space.](https://developer.android.com/static/develop/ui/compose/images/layouts/adaptive/flexbox/growitems-2.png) |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "In the following example, the container size and `basis` size are the same. The"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "difference is that each child has a different `grow` value."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "|---|---|"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| ```kotlin FlexBox { RedRoundedBox( title = \"150dp\", modifier = Modifier.flex { grow(1f) } ) BlueRoundedBox( title = \"200dp\", modifier = Modifier.flex { grow(2f) } ) GreenRoundedBox( title = \"250dp\", modifier = Modifier.flex { grow(3f) } ) } ``` | Each child has a basis value of `100dp`. There is `300dp` of extra space. ![Three items with 100dp basis each, in a 600dp container, before growth, with different grow values.](https://developer.android.com/static/develop/ui/compose/images/layouts/adaptive/flexbox/growitems-3.png) The total grow value is 6. Child 1 grows by (1 / 6) \\* 300 = `50dp` Child 2 grows by (2 / 6) \\* 300 = `100dp` Child 3 grows by (3 / 6) \\* 300 = `150dp` ![Items grow to fill 300dp of extra space based on relative grow values.](https://developer.android.com/static/develop/ui/compose/images/layouts/adaptive/flexbox/growitems-4.png) |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Shrink items when there\'s insufficient space"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Use `shrink` to specify how much an item shrinks when the `FlexBox` container"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "has insufficient space for all the items. `shrink` works the same way as `grow`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "except that, instead of distributing *extra space* to items, the *space deficit*"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "is distributed to items. The `shrink` value specifies how much of the space"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "deficit the item receives, or rather, how much the item will shrink by. By"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "default, items have a `shrink` value of `1f`, meaning they shrink equally."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "The following example shows two `Text` composables with the same text. The first"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "child has a shrink value of `1f`, meaning it shrinks to absorb all the space"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "deficit."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```kotlin"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "FlexBox {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    Text("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"The quick brown fox\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        fontSize = 36.sp,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        modifier = Modifier"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            .background(PastelRed)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            .flex { shrink(1f) }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    )"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    Text("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"The quick brown fox\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        fontSize = 36.sp,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        modifier = Modifier"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            .background(PastelBlue)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            .flex { shrink(0f) }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    )"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "<br />"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "As the container size shrinks, Child 1 shrinks."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "|---|---|"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| **Container size** | **FlexBox UI** |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| `700dp` | ![Two items in a 700dp container.](https://developer.android.com/static/develop/ui/compose/images/layouts/adaptive/flexbox/containersize-1.png) |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| `500dp` | ![First item shrinks as container size reduces to 500dp.](https://developer.android.com/static/develop/ui/compose/images/layouts/adaptive/flexbox/containersize-2.png) |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| `450dp` | ![First item shrinks further as container size reduces to 450dp.](https://developer.android.com/static/develop/ui/compose/images/layouts/adaptive/flexbox/containersize-3.png) |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Item alignment"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Use `alignSelf` to control how an item is aligned to the cross axis. This"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "overrides the [`alignItems` property](https://developer.android.com/develop/ui/compose/layouts/adaptive/flexbox/container-behavior#align-distribute) of the container for this item. It"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "has all the same possible values, with the addition of `Auto` which inherits the"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "behavior of the `FlexBox` container."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "For example, this `FlexBox` has `alignItems` set to `Start` and five children"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "which override the cross axis alignment."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```kotlin"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "FlexBox("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    config = {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        alignItems(FlexAlignItems.Start)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: ") {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    RedRoundedBox()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    BlueRoundedBox(modifier = Modifier.flex { alignSelf(FlexAlignSelf.Center) })"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    GreenRoundedBox(modifier = Modifier.flex { alignSelf(FlexAlignSelf.End) })"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    PinkRoundedBox(modifier = Modifier.flex { alignSelf(FlexAlignSelf.Stretch) })"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    OrangeRoundedBox(modifier = Modifier.flex { alignSelf(FlexAlignSelf.Baseline) })"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "<br />"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "![Five children of varying sizes overriding the alignItems property.](https://developer.android.com/static/develop/ui/compose/images/layouts/adaptive/flexbox/item-alignment.png)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Item order"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "By default, `FlexBox` lays out items in the order that they are declared in"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "code. Override this behavior using `order`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "The default value for `order` is zero, and `FlexBox` sorts items based on this"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "value in ascending order. Any items that have the same `order` value are"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "laid out in the same order they are declared in. Use negative and positive"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`order` values to move items to the start or end of a layout without changing"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "where they are declared."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "The following example shows two child items. The first has the default `order`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "of zero, and the second has an order of `-1`. After sorting, Child 1 appears"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "after Child 2."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```kotlin"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "FlexBox {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Declared first, but will be placed after visually"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    RedRoundedBox("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        title = \"World\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    )"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Declared second, but will be placed first visually"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    BlueRoundedBox("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        title = \"Hello\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        modifier = Modifier.flex {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            order(-1)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    )"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "<br />"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "![Two rounded boxes, with the first containing the text Hello and the second containing the text World.](https://developer.android.com/static/develop/ui/compose/images/layouts/adaptive/flexbox/itemorder.png)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
      }
    }
  }
}
