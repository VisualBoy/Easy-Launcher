        }
        lines {
          text: "# Passing Arguments to ViewModels (Koin)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "This recipe demonstrates how to pass navigation arguments (keys) to a `ViewModel` using Koin for dependency injection."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## How it works"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "1. A Koin module is defined that provides the `ViewModel`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "2. The `koinViewModel` composable function is used to get the `ViewModel` instance."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "3. The navigation key is passed to the `ViewModel`\'s constructor using `parametersOf(key)`. This makes the navigation key available to the `ViewModel`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "**Note** : The `rememberViewModelStoreNavEntryDecorator` is added to the `NavDisplay`\'s `entryDecorators`. This ensures that `ViewModel`s are correctly scoped to their corresponding `NavEntry`, so that a new `ViewModel` instance is created for each unique navigation key."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
