        }
        lines {
          text: " * Provides navigation events with built-in support for conditional access. If the user attempts to"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: " * navigate to a [ConditionalNavKey] that requires login ([ConditionalNavKey.requiresLogin] is true)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: " * but is not currently logged in, the Navigator will redirect the user to a login key."
