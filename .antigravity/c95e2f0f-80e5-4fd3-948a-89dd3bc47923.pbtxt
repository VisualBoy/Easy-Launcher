        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Legacy DSL for AGP versions lower than 9.3"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "To enable app optimization, set `isMinifyEnabled = true` (for code optimization)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "and `isShrinkResources = true` (for resource optimization) in your [release"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "build\'s](https://developer.android.com/studio/publish/preparing#turn-off-debugging) app-level build script. We recommend that you always enable both"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "settings."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Legacy DSL (Kotlin)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    android {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
