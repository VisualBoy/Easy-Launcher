        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "<br />"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Place items in a grid"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`Grid` takes the UI elements"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "in the `content` lambda and places them into grid cells."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "The grid lays out items regardless of"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "whether you have explicitly defined the rows and columns."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "By default,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`Grid` tries to place a UI element in the available grid cell in the row;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "if it can\'t, it places it in an available grid cell in the next row."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "If there are no empty cells, `Grid` creates a new row."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "In the following example, the grid has six grid cells"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "and places a card into each one (Figure 1)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Each grid cell is `160dp` x `90dp`,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "making the total grid size `320dp` x `270dp`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```kotlin"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Grid("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    config = {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        repeat(2) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            column(160.dp)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        repeat(3) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            row(90.dp)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: ") {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    Card1()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
