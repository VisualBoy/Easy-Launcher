        }
        lines {
          text: "customize the testing process."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "#### Inject types in tests"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "To inject types into a test, use `@Inject` for field injection. To tell Hilt to"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
