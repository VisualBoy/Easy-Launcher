    }
  }
  file_change {
    absolute_path_uri: "file:///.agents/skills/android-cli/references/interact.md"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    diff {
      unified_diff {
        lines {
          text: "# Tools"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Run `android layout --help` and `android screen --help`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## UI Dump"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`android layout`  returns a flat JSON list of the UI elements on screen."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`android layout --diff` returns a flat JSON list of the UI elements that have changed since the last call to `layout` or `layout --diff`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Each JSON object represents a UI element in the Android app. The following properties may be present:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- `text` - any literal text the element contains"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- `resourceId` - the Android resource id used to refer to the element"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- `contentDesc` - a description of a UI element for use by accessibility tools"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- `interactions` - the set of user interactions the element supports. May contain one or more of: `checkable`, `clickable`, `focusable`, `scrollable`, `long-clickable`, `password`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- `state` - the set of states the element is in. May contain one or more of `checked`, `focused`, `selected`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- `bounds` - the screen coordinates of the bounding rectangle of the element, in the format `[min X,min Y][max X, max Y]`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- `center` - the screen coordinates of the center of the element, in the format `[x,y]`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- `off-screen` - if true, the element is in the UI hierarchy but not visible; it may require scrolling to view."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Use `layout` as a primary means of examining an Android app. Use `layout --diff` to focus on changes and to keep your context small."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Example: When entering digits into a calculator, use `layout --diff` to output only the digit readout element."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`layout` may fail due to the app displaying a WebView or animation; in these cases, use `android screen --annotate` to inspect the app."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "This failure will likely resolve after navigating away from the current screen."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Screenshot"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`android screen capture -o <file path>` saves a PNG of the current device screen to `<file path>`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Use `screen capture` as a secondary means of examining an Android app"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Examples:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Understanding the content of an on-screen image"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Looking at a `WebView` (web content does not always appear in the ui dump)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Trying to find a UI element by its visual appearance"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "**IMPORTANT**: Always *VISUALLY* examine the PNG image returned from `android screen` BEFORE doing anything else."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Annotated Screenshot"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`android screen capture --annotate -o <file path>`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`android screen resolve --screen <path> --string <string>`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "The `--annotate` command adds numerical labels and bounding boxes around UI elements. Use this command to locate UI elements that cannot"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "be located in the `layout` output."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "**IMPORTANT**: When using `android screen --annotate`, always *VISUALLY* examine the resulting PNG file."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "To refer to these labels in input commands, use `screen resolve` to convert labels into coordinates:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`android screen resolve --screen <file path> --string \"#3\"` returns `<x coord of region 3> <y coord of region 3>`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "To save turns, you can combine shell commands:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`adb shell input $(android screen resolve --screen screen.png --string \"tap #34\")`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "This command taps on region #34 from `screen.png`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Input"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Use `adb shell input` for interacting with Android devices."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Refer to the `\"interactions\"` property of an element for what interactions can be performed on a particular element."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Interact with UI elements with their `center` coordinate or their `bounds` coordinates:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```json"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "{"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  \"key\": -248568265,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  \"class\": \"android.widget.Button\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  \"bounds\": \"[138,9][167,38]\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  \"center\": \"[152,23]\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "To tap on this button, you would execute `adb shell input tap 152 23`. This taps the center."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```json"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "{"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  \"key\": 12487234,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  \"class\": \"com.example.ui.ScrollableList\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  \"bounds\": \"[100,200][400,600]\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  \"center\": \"[250,400]\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "To scroll down on this list, you would execute `adb shell input swipe 250 400 250 200 500`. This swipes from the center to the top over 500ms."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "# Android Interaction Rules"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "1. Always ensure text input fields have `\"focused\"` in their `\"state\"` list before entering text"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "2. If an element has `\"scrollable\"` in its `\"interactions\"` list, try scrolling it when looking for missing UI elements"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "2. Always scroll slowly when executing scroll inputs. The 5th argument to `adb shell input swipe` controls scroll duration."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "3. Content may take time to load; if a `layout` is missing information after you take an action, wait a few seconds, then perform `layout --diff` to see if anything changes."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
      }
    }
  }
}
