        lines {
          text: "name: edge-to-edge"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "description: Use this skill to migrate your Jetpack Compose app to add adaptive edge-to-edge"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  support and troubleshoot common issues. Use this skill to fix UI components (like"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  buttons or lists) that are obscured by or overlapping with the navigation bar or"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  status bar, fix IME insets, and fix system bar legibility."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "license: Complete terms in LICENSE.txt"
