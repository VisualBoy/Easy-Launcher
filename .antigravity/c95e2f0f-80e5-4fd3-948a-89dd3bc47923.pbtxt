        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "In Navigation 2, you [define your destinations](https://developer.android.com/guide/navigation/design#compose)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "using the [NavGraphBuilder DSL](https://developer.android.com/guide/navigation/design/kotlin-dsl#navgraphbuilder),"
