        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "1. Add the `navigationevent` artifact to your project. This is the core library"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
