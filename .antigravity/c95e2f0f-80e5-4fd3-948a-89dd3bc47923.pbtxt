  file_change {
    absolute_path_uri: "file:///.agents/skills/styles/references/android/develop/ui/compose/styles/fundamentals.md"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    diff {
      unified_diff {
        lines {
          text: "There are three ways you can adopt Styles throughout your app:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "1. Use directly on existing components that expose a [`Style`](https://developer.android.com/reference/kotlin/androidx/compose/foundation/style/Style) parameter."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "2. Apply a style with [`Modifier.styleable`](https://developer.android.com/reference/kotlin/androidx/compose/foundation/style/styleable.modifier#(androidx.compose.ui.Modifier).styleable(androidx.compose.foundation.style.StyleState,androidx.compose.foundation.style.Style)) on layout composables that don\'t accept a `Style` parameter."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "3. In your own custom design system, use `Modifier.styleable{}` and expose a style parameter on your own components."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Available properties on Styles"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Styles support many of the same properties that modifiers support; however, not"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "everything that is a modifier can be replicated with a Style. You still need"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "modifiers for certain behaviors, like interactions, custom drawing, or stacking"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "of properties."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| Grouping | Properties | Inherited by children |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "|---|---|---|"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| **Layout and sizing** |   |   |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| Content Padding (inner) | - `contentPadding(all: Dp)` - `contentPadding(horizontal: Dp, vertical: Dp)` - `contentPadding(start: Dp, top: Dp, end: Dp, bottom: Dp)` - `contentPaddingHorizontal(value: Dp)` / `contentPaddingVertical(value: Dp)` - `contentPaddingStart(value: Dp)` / `contentPaddingTop(value: Dp)` / `contentPaddingEnd(value: Dp)` / `contentPaddingBottom(value: Dp)` | No |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| External Padding (outer) | - `externalPadding(all: Dp)` - `externalPadding(horizontal: Dp, vertical: Dp)` - `externalPadding(start: Dp, top: Dp, end: Dp, bottom: Dp)` - `externalPaddingHorizontal(value: Dp)` / `externalPaddingVertical(value: Dp)` - `externalPaddingStart(value: Dp)` / `externalPaddingTop(value: Dp)` / `externalPaddingEnd(value: Dp)` / `externalPaddingBottom(value: Dp)` | No |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| Dimensions | `fillWidth()/fillHeight()/fillSize()` and `width`, `height`, and `size` (supports `Dp`, `DpSize`, or `Float` fractions). | No |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| Positioning | `left/top/right/bottom` offsets. | No |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| **Visual Appearance** |   |   |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| Fills | `background` and `foreground` (supports `Color` or `Brush`). | No |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| Borders | `borderWidth`, `borderColor`, and `borderBrush`. | No |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| Shape | `shape` | No - but used in conjunction with other properties. `clip` and `border` use this defined shape. |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| Shadows | `dropShadow`, `innerShadow` | No |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| **Transformations** |   |   |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| Graphics layer spatial movement | `translationX`, `translationY`, `scaleX/scaleY`, `rotationX/rotationY/rotationZ` | No |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| Control | `alpha`, `zIndex` (stacking order), and `transformOrigin` (pivot point) | No |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| **Typography** |   |   |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| Styling | `textStyle`, `fontSize`, `fontWeight`, `fontStyle`, and `fontFamily` | Yes |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| Coloration | `contentColor` and `contentBrush`. This is also used for Icons styling. | Yes |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| Paragraph | `lineHeight`, `letterSpacing`, `textAlign`, `textDirection`, `lineBreak`, and `hyphens`. | Yes |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| Decoration | `textDecoration`, `textIndent`, and `baselineShift`. | Yes |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Use Styles directly on components with Style parameters"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Components that expose a `Style` parameter allow you to set their styling:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```kotlin"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "BaseButton("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    onClick = { },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    style = { }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: ") {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    BaseText(\"Click mnippets.kt"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "<br />"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Within the style lambda, you can set various properties, such as `externalPadding`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "or `background`:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```kotlin"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "BaseButton("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    onClick = { },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    style = { background(Color.Blue) }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: ") {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    BaseText(\"Click mnippets.kt"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "<br />"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "For the full list of supported properties, see [Available properties on"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Styles](https://developer.android.com/develop/ui/compose/styles/fundamentals#properties-styles)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Apply Styles using modifiers for components with no existing parameter"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "For components that lack a built-in style parameter, you can still apply styles"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "with the `styleable` modifier. This approach is also useful when developing your"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "own custom components."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```kotlin"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Row("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    modifier = Modifier.styleable { }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: ") {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    BaseText(\"Contennippets.kt"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "<br />"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Similar to the `style` parameter, you can include properties like `background`,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`contentPadding`, or `externalPadding` inside the lambda."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```kotlin"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Row("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    modifier = Modifier.styleable {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        background(Color.Blue)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: ") {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    BaseText(\"Contennippets.kt"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "<br />"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "> [!NOTE]"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "> **Note:** When using `Modifier.styleable`, the child composables won\'t have those properties applied to them, unless they are inherited properties. Only the container with the `styleable` modifier has those properties applied."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Multiple chained `Modifier.styleable` modifiers are additive with non-inherited"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "properties on the applied composable, behaving similarly to multiple modifiers"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "defining the same properties. For inherited properties, these are overridden,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "and the last `styleable` modifier in the chain sets the values."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "When using `Modifier.styleable`, you may also want to create and supply a"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`StyleState` to be used with the modifier to apply state-based styling. For more"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "details, see [State and animations with"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Styles](https://developer.android.com/develop/ui/compose/styles/state-animations)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Define a standalone Style"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "You can define a standalone Style for reusability purposes:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```kotlin"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "val style = Style { background(Color.Blue) }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "<br />"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "You can then pass that defined style into a composable\'s style parameter or with"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`Modifier.styleable`. When using `Modifier.styleable`, you also need to create a"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`StyleState` object. `StyleState` is covered in detail in the [State and"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "animations with Styles](https://developer.android.com/develop/ui/compose/styles/state-animations) documentation."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "The following example shows how you can apply a Style either directly through a"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "component\'s built-in parameters, or through a `Modifier.styleable`:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```kotlin"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "val style = Style { background(Color.Blue) }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "// built in parameter"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "BaseButton(onClick = { }, style = style) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    BaseText(\"Button\")"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "// modifier styleable"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "val styleState = remember { MutableStyleState(null) }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Column("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    Modifier.styleable(styleState, style)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: ") {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    BaseText(\"Col)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "}StylesSnippets.kt"
