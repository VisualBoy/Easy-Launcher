          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Register the service and reference the app metadata in `AndroidManifest.xml`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "within the `<application>` tag:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
