        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "<br />"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "> [!IMPORTANT]"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "> **Important:** The `appFunctionXmlFileName` parameter, for example `\"my_app_function_service\"`, mustn\'t include the `.xml` extension, as the KSP compiler automatically appends `.xml`. Passing `\"my_app_function_service.xml\"` results in the asset being named `\"my_app_function_service.xml.xml\"`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
