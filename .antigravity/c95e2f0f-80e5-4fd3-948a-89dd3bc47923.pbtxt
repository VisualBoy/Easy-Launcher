          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            f\"Obfuscation Score:  {score(tot_obf, \'-dontobfuscate\'):.2f}%\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            f\"Shrinking Score:    {score(tot_shr, \'-dontshrink\'):.2f}%\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        ]"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
