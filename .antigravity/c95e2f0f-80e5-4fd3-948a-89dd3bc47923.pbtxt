        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Use Material components"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "When one or more systems of `MaterialTheme` have been replaced, using Material"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "components as-is may result in unwanted Material color, type, or shape values."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "If you want to use replacement values in components, wrap them in your own"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "composable functions, directly setting the values for the relevant system, and"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "exposing others as parameters to the containing composable."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "> [!NOTE]"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "> **Note:** Not all values may be exposed as parameters in Material composables, in particular with `CompositionLocal` composables (such as `LocalTextStyle`). In such cases you may need to wrap `content` lambdas in provider functions (like `ProvideTextStyle`)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
