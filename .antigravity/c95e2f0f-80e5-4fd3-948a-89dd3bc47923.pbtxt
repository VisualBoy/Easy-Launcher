        lines {
          text: "To set up your development environment for `NavigationEvent`, follow these"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "steps."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Declare dependencies"
