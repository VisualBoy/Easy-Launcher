        lines {
          text: "1. **Aggiunta ML Kit Text Recognition:**"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "   - Aggiungere `com.google.android.gms:play-services-mlkit-text-recognition`."
