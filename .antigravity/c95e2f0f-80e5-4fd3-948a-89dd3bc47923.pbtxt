    file_change_type: FILE_CHANGE_TYPE_CREATE
    diff {
      unified_diff {
        lines {
          text: "Navigation Event is a library that provides a Kotlin Multiplatform (KMP)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "solution for integrating system-level navigation events into your application."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "It is designed to be the foundational layer for handling navigation directions"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "across various [supported platforms](https://developer.android.com/kotlin/multiplatform#kotlin-multiplatform-and-jetpack-libraries)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Key concepts"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "The Navigation Event system is built around a centralized dispatcher-handler"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "model, often used in a parent-child hierarchy to map to complex UI structures,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "such as those found in Jetpack Compose."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### `NavigationEventDispatcher`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "The [`NavigationEventDispatcher`](https://developer.android.com/reference/kotlin/androidx/navigationevent/NavigationEventDispatcher) is the central class responsible for"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "managing all registered navigation event consumers"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "([`NavigationEventHandler`](https://developer.android.com/reference/kotlin/androidx/navigationevent/NavigationEventHandler))) and orchestrating the flow of events."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "In a hierarchical setup, all dispatchers within the same chain share a single"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`NavigationEventProcessor`, which manages the global state and ensures a single,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "unified dispatching order across the entire tree."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### `NavigationEventHandler`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`NavigationEventHandler` is an abstract class that receives and handles"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "navigation events dispatched by a `NavigationEventDispatcher`. It defines"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "callback methods that correspond to different stages of a navigation gesture"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "lifecycle, such as when a gesture starts, progresses, completes, or is"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "cancelled."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Handlers can respond to these events to update UI or application state in"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "response to user navigation actions. Multiple handlers can be registered with a"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "dispatcher and are invoked based on priority and registration order."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### `NavigationEvent`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "[`NavigationEvent`](https://developer.android.com/reference/androidx/navigationevent/NavigationEvent) is a data class that carries the details of the"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "navigation gesture."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### `NavigationEventInfo`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "[`NavigationEventInfo`](https://developer.android.com/reference/androidx/navigationevent/NavigationEventInfo) is an abstract class that provides contextual"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "information about a navigation state."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### `NavigationEventInput`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "[`NavigationEventInput`](https://developer.android.com/reference/androidx/navigationevent/NavigationEventInput) is an abstract class for components that generate"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "and dispatch navigation events. It acts as the \"input\" side of the navigation"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "system, translating platform-specific events (like system back gestures or"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "button clicks) into standardized events that can be sent to a"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`NavigationEventDispatcher`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Supported navigation directions and triggers"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "The Navigation Event system is designed to encompass more than just the system"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "back button, with designs supporting multiple navigation directions and input"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "methods across platforms."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Supported directions"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Different platforms support varying navigation directions:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "|---|---|---|---|---|"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| **Platform** | **Back** | **Up** | **Forward** | **Home** |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| **Android phone** | \342\234\205 | \342\234\205 | \360\237\232\253 | \342\234\205 |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| **Android tablet** | \342\234\205 | \342\234\205 | \360\237\232\253 | \342\234\205 |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| **Web (Browser)** | \342\234\205 | \342\234\205 | \342\234\205 | \360\237\232\253 |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| **iOS (iPhone/iPad)** | \342\234\205 | \360\237\232\253 | \342\234\205 | \342\234\205 |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Supported triggers"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Input handling is achieved through various mechanisms on each platform:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "|---|---|---|---|"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| **Trigger** | **Android Phone** | **Web (Browser)** | **iOS (iPhone/iPad)** |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| **Keyboard back button** | \342\234\205 Back | \342\235\223 | \342\234\205 Back |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| **Software back button** | \360\237\232\253 | \342\234\205 Back | \342\234\205 Back |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| **Software up button** | \342\234\205 Up | \360\237\232\253 | \360\237\232\253 |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| **Gesture from left** | \342\234\205 Back | \342\235\223 | \342\234\205 Back |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| **Gesture from right** | \342\234\205 Back | \342\235\223 | \342\234\205 Forward |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| **Gesture from bottom** | \342\234\205 Home | \360\237\232\253 | \342\234\205 Home |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "> [!NOTE]"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "> **Note:** The **Web** platform has unique navigation handling, where the browser controls the back stack state. This requires synchronization between the browser window and the application\'s navigation stack. The question mark represents behavior that is inconsistent because web browsers don\'t have a single, unified \"back\" button or gesture."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
      }
    }
  }
}
