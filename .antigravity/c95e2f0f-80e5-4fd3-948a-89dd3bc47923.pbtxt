          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "app launches, the media player is in the `Stopped` state, so it\'s initialized in"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "this way:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```kotlin"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "enum class PlayerState {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
