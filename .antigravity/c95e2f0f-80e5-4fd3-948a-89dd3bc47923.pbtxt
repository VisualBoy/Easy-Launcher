        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Note that `ComponentActivity` needs to be added to your app\'s"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`AndroidManifest.xml` file. Enable that by adding this dependency to your"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "module:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    debugImplementation(\"androidx.compose.ui:ui-test-manifest:$compose_version\")"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Custom semantics properties"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "You can create custom [semantics](https://developer.android.com/develop/ui/compose/testing/semantics) properties to expose information to tests."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "To do this, define a new `SemanticsPropertyKey` and make it available using the"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`SemanticsPropertyReceiver`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
