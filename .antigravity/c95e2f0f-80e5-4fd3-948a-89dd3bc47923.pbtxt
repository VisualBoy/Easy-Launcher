        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "This skill provides procedural guidance and standard patterns for building"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "camera applications on Android, with a focus on CameraX, including its"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`Camera2Interop` utilities, and Media3 integrations."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Core workflows"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Handling immutable API patterns"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Various Android camera and media APIs, especially CameraX `VideoCapture`, use a"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "**fluent, immutable builder-like pattern** where methods return a new instance."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Failing to reassign these results in settings, such as audio, being ignored."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "**Pattern: Reassignment is required**"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```kotlin"
