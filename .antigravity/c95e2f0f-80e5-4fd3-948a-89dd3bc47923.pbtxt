        }
        lines {
          text: "the current status and the device capabilities."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "The function returns a boolean value,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "so you can determine the layout with conditional branches"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "like an `if` expression."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Table 1 describes the parameters available in `UiMediaScope`."
