          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    ) { /* Content */ }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "<br />"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "*** ** * ** ***"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "RIGHT because the default `contentWindowInsets` does not contain IME insets, and"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`imePadding()` applies IME insets:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```kotlin"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "// RIGHT"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Scaffold() { innerPadding ->"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    Column("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
