        lines {
          text: "## 6. Compatibility & Risk Mitigation"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Backward Compatibility"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Keep existing `findAccessibilityNodeInfosByViewId()` calls** as fast path (no allocation overhead)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Use `dumpScreen()` as fallback** when ID lookup fails"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **No breaking changes** to external APIs"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Device Compatibility"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Test on Android 8.0 (API 26) minimum \342\234\223"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- `takeScreenshot()` requires API 31 (R) \342\206\222 guard with `@RequiresApi`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Fall back to gesture-only if screenshot unavailable"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Performance"
