          text: "\342\234\205 **Shared Accessibility** \342\200\224 Both isolates can access screen via same MethodChannel  "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "\342\234\205 **Native Performance** \342\200\224 Foreground Service + WindowManager for smooth rendering  "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
