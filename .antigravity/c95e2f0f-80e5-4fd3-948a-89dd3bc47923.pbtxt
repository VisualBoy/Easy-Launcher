          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Remove legacy configuration provider"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Update your `Application` class by removing"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`AppFunctionConfiguration.Provider` and its associated builder entry points:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    -   abstract class BaseChatApplication : Application(), AppFunctionConfiguration.Provider { ... }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    +   abstract class BaseChatApplication : Application()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "*** ** * ** ***"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Avoid redundant abstraction layers"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Don\'t attempt to make an `AppFunction` class or method OS-agnostic---AppFunctions"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "are inherently part of the Android platform integration through the"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`androidx.appfunctions` package. For architectural cleanliness, use existing"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "application functionality, such as existing repositories, use cases, or domain"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "orchestrators, to execute the behavior within your `@AppFunction` methods rather"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "than creating redundant abstraction layers around the OS service."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "*** ** * ** ***"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Consolidate service and metadata manifest declarations"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Register the KSP-generated service declaration and `app_metadata` property"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "inside your module manifest, for example in `src/main/AndroidManifest.xml`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "within the `<application>` tag:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
