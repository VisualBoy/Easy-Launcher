          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    Area3,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    Area4"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "}"
