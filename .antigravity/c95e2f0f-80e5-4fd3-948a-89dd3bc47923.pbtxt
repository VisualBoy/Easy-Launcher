        }
        lines {
          text: "### Testing features"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Once Hilt is ready to use in your tests, you can use several features to"
