    }
    source: CORTEX_STEP_SOURCE_USER_EXPLICIT
    completed_at {
      seconds: 1788915670
      nanos: 809183000
    }
  }
  file_change {
    absolute_path_uri: "file:///.agents/skills/testing-setup/SKILL.md"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    diff {
      unified_diff {
        lines {
          text: "---"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "name: testing-setup"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "description: Analyze and create a testing strategy for native Android apps - install"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  testing libraries, set up test infrastructure, create harnesses for unit tests,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  UI tests, screenshot tests, and end-to-end tests."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "license: Complete terms in LICENSE.txt"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "metadata:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  author: Google LLC"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  last-updated: \'2026-09-03\'"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  keywords:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - android"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - testing"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - ui tests"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - screenshot tests"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - coverage"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "---"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Step 1: analyze the current testing setup"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "To understand the testing setup of an existing project, look for these"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "dependencies in the libs.versions.toml file, or build files:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "1. Dependency Injection framework used. Examples: Hilt, Koin, Anvil, vanilla Dagger..."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "2. Unit (local) testing framework this project uses, Example JUnit4, JUnit5..."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "3. Mocking framework (if any) used for unit tests, and for Instrumented and UI tests. Examples: Mockito, Mockk..."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "4. Robolectric. It can be used in 3 ways:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "   1. Used in unit tests to have fakes for platform entities"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "   2. To run behavior UI tests without a device or emulator. For example, used to run Espresso or Compose tests."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "   3. To do screenshot testing with Roborazzi"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "5. Is the app 100% Compose, Views or hybrid?"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "6. Behavior UI tests:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "   1. Compose Tests (`androidx.compose.ui:ui-test-*`)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "   2. Espresso Tests for Views. Might use wrappers like Kaspresso. Dependencies: `androidx.test.espresso:espresso-core`, `androidx.test:runner`, `androidx.test:rules`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "7. Screenshot tests can be:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "   1. Instrumented (device-based). For example, using Dropshots."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "   2. Based on Robolectric, so they run locally. For example, using Roborazzi."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "   3. Based on LayoutLib, so they run locally. For example, Paparazzi, or the Compose Preview Screenshot Testing tool."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "8. End to end tests (also known as Release Candidate tests) always run on device and use high-level frameworks such as UIAutomator, Appium, or Robotium."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "9. Generate a Markdown report with the analysis"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Step 2: Set up Dependency Injection frameworks for testing"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "If there is no Dependency Injection framework, install one: if it\'s a"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "multiplatform application, ask the user whether they want to install Koin, or"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "kotlin-inject. If it\'s not multiplatform, install Hilt."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Install the testing dependencies (for example `com.google.dagger:hilt-compiler`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "that should be applied with a `kspAndroidTest` configuration)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "> [!IMPORTANT]"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "> **Important:** Always consult the documentation of the applicable framework to learn about testing (for example: [Hilt testing guide](references/android/training/dependency-injection/hilt-testing.md), [Koin Instrumented tests](https://insert-koin.io/docs/reference/koin-android/instrumented-testing))."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "For instrumented tests, create and configure (by adding"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`testInstrumentationRunner` to the build gradle files) a new test runner and"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "apply the testing rules required by the framework (for example in Hilt, annotate"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "your test classes with `@HiltAndroidTest` and apply the `HiltAndroidRule`)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Other frameworks use other mechanisms, consult their documentation."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Step 3: Install frameworks"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Unless otherwise specified, respect the current stack of testing frameworks."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "If there are no testing frameworks, and the user didn\'t specify any preference,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "install the following:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- JUnit4 for local and instrumented tests"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Jacoco for test coverage"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- For UI tests: if the project has views, Espresso. If it\'s fully Compose, use the Compose Testing APIs."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Robolectric to run UI Tests"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Compose Preview Screenshot Testing tool for screenshot tests - check [setup"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  documentation](references/android/studio/preview/compose-screenshot-testing.md) and follow it strictly."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Dropshots for device screenshot tests"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- If a mocking framework is necessary, install Mockk (`io.mockk:mockk`). Do not install it unless it is clearly necessary."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "If instrumented screenshot tests are requested, install Dropshots."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "If end-to-end testing is requested, install UI Automator."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Step 4: Refactor and create fakes for testing"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### **Refactor for unit tests**"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "In the next sections you\'ll be asked to create tests. If you have dependencies"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "on Android framework classes, or entities that are not part of the codebase:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- First, use a fake. If it doesn\'t exist, create an interface for the class"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  and a \"Default\" implementation with the existing code. Add the Fake version"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  to the test sourceset (test or androidTest)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- If not possible to use a fake (example: no access to the class or"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  interface), mock the dependencies."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### **Refactor for UI tests**"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "If you need to fake components to make testing easier and faster and more"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "reliable, replace slow and problematic dependencies with fakes. Use runtime"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "fakes using the Dependency Injection framework installed to:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Simulate** different scenarios with the user (wrong credentials, reset password flow...), with a server (no connection, server down, bad JSON from server...) or with a platform component (insufficient permissions, no disk space, no front camera available)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Improve** speed and reliability (replacing a database with an in-memory database, replacing a repository with an in-memory fake to avoid hitting the network)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Step 5: Unit testing"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Create a task to add or review unit tests in every file that contains business"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "logic (ViewModels, Repositories, database-related classes such as DAOs, etc.)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Don\'t create unit tests for Activities, Compose layouts, or dependency injection"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "configuration files."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Step 6: UI testing"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Espresso or Compose UI tests live in the `test` sourceset because they will be"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "run with Robolectric. If instrumented (emulator or device) tests are requested,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "put them in the `androidTest` sourceset."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Step 7: Test databases"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "If the database is using SQLite (using Room, SQLDelight, etc.), create"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "instrumented tests using an in-memory database to make sure that they work with"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "the SQLite engine on device."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Step 8: Screenshot tests"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Irrespective of the framework used, screenshot tests focus on 2 types of tests:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Screen-level screenshot tests, where each screen is tested in 9 different sizes, combining compact, medium and expanded widths (400, 610, 900 dp) and heights (400, 500 and 1000 dp)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Screen-level variations. Add a mobile (400x500) screenshot of:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - All the alternative themes, if used."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - Font scale set to 1.5."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Component-level screenshot tests, where each component is tested in different themes and font scales."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Behavior isn\'t tested with screenshots, but do test different common scenarios"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "if their UIs change a lot depending on the state. For example, test loading"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "screens by injecting a loading state to the UI or simulating it with a fake."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Step 9: UI Behavior tests"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Test the UI logic using behavior tests, which ensures that the UIs react as"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "expected when different states are passed, and when user actions are performed."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### **Compose UI behavior tests**"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Use the ComposeTestRule with a `ComponentActivity` to access resources such as strings."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Always try to match with semantic matchers first. If the matcher is too complicated to write (using more than 3 matchers to find a single element), use `testTag`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Always verify state restoration"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### **Views (XML) UI behavior tests**"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Use Espresso to match views and interact with them."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Step 10: Navigation tests"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Create a test suite to verify navigation logic. Include:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Back handling"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Deeplinks"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Special patterns like \"exit through home\" with multiple backstacks."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Step 11: Simulate different window sizes and settings"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "For Compose layouts, use `DeviceConfigurationOverride` described in \"[UI testing"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "common patterns](references/android/develop/ui/compose/testing/common-patterns.md)\" to simulate different window sizes, font scales"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Step 12: End-to-end tests"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Create a low number (about 5% of all tests) of end-to-end tests that cover big"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "user journeys. Use Compose Test APIs or Espresso for that. If you have to access"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "platform features (notifications, system UI...), use UI Automator."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "If you need to take screenshots of the app running in a device, use"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "[Dropshots](https://raw.githubusercontent.com/dropbox/dropshots/refs/heads/main/README.md). You need a device for screenshot tests when verifying"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "interaction with the system UI (examples: edge-to-edge rendering, notifications,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "picture-in-picture)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Step 13: Instrumented Screenshot tests"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
