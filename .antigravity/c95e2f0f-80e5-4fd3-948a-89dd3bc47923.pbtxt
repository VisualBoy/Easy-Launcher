        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "<br />"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Add a `NavigationEventInput`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Now that you\'ve registered the handler, you are set up to receive events."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "However, you need to provide a source from which the events are generated with"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`NavigationEventInput`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`NavigationEventInput` is the platform-specific component that receives"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "raw system input and translates it into a standard `NavigationEvent` to be sent"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "to the `NavigationEventDispatcher`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "The following example is a custom implementation of a `NavigationEventInput`:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```kotlin"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "public class MyInput : NavigationEventInput() {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    @MainThread"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    public fun backStarted(event: NavigationEvent) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        dispatchOnBackStarted(event)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    @MainThread"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    public fun backProgressed(event: NavigationEvent) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        dispatchOnBackProgressed(event)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    @MainThread"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    public fun backCancelled() {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        dispatchOnBackCancelled()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    @MainThread"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    public fun backCompleted() {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        dispatchOnBackCompleted()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "<br />"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Next, provide that input to your dispatcher:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```kotlin"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "navigationEventDispatcher.addInput(MyInput())"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "<br />"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "> [!NOTE]"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "> **Note:** To provide a simple input, use the [`DirectNavigationEventInput`](https://developer.android.com/reference/androidx/navigationevent/DirectNavigationEventInput) class."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Clean up resources with `dispose()`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "To prevent memory leaks in a dynamic UI, every created"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`NavigationEventDispatcher` instance must be explicitly removed from the"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "hierarchy using the `dispose()` method when the component it is tied to is"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "destroyed:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```kotlin"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "navigationEventDispatcher.dispose()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "<br />"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "The `dispose()` method ensures a *cascading cleanup* by iteratively removing"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "the dispatcher and all of its descendants (children and grandchildren),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "guaranteeing that all associated handlers are unregistered from the shared"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "system."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Dispatcher hierarchy and control"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "The `NavigationEventDispatcher` supports a parent-child hierarchy, enabling"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "components nested deep within a UI (such as nested `NavHost`s or dialogs) to"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "participate in navigation event handling."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "#### Create a child dispatcher"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "A child dispatcher is created by passing a reference to its parent dispatcher"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "during construction. All dispatchers in a hierarchy share the same"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`NavigationEventProcessor` to maintain a global **Last-In, First-Out (LIFO)**"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "event ordering based on priority."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "#### Hierarchical enabling"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "The dispatcher includes an `isEnabled` property that allows developers to enable"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "or disable an entire subtree of handlers at once."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "When a parent dispatcher is disabled (`isEnabled = false`), all handlers"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "associated with that parent and any of its children will be ignored, regardless"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "of their individual enabled state."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
      }
