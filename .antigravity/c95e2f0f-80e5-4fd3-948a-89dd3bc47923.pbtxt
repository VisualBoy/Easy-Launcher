        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Verification and troubleshooting"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "1. **Clean rebuild and deploy** : `bash"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "   ./gradlew clean installDebug`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "2. **Verify AppSearch discovery / indexing** : Run the following ADB command to"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "   confirm the OS successfully discovered and indexed your functions:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "   `bash"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
