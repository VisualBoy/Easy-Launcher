        }
        lines {
          text: "```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "<br />"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Provide the name for the area using the `areaId` parameter along with the area\'s"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "cell coordinates and spans."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "The `gridItem` modifier uses the `areaId` as a key"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "to assign each child item to its designated grid area,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "as shown in the following example:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```kotlin"
