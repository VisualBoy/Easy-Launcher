steps {
  type: CORTEX_STEP_TYPE_FILE_CHANGE
  status: CORTEX_STEP_STATUS_DONE
  metadata {
    created_at {
      seconds: 1788903471
      nanos: 721378000
    }
    source: CORTEX_STEP_SOURCE_USER_EXPLICIT
    completed_at {
      seconds: 1788903471
      nanos: 721378000
    }
  }
  file_change {
    absolute_path_uri: "file:///README.md"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    diff {
      unified_diff {
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "# \360\237\214\237 Easy Launcher  "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Lo smartphone che risponde **sempre**, anche senza internet.  "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "**Easy Launcher** trasforma qualsiasi telefono Android in un **assistente intelligente**, semplice e sicuro.  "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Funziona con **la voce**, con **pulsanti extra-large**, e soprattutto con una **IA offline** che garantisce autonomia anche quando la connessione non c\342\200\231\303\250."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Pensato per chi ha bisogno di un supporto concreto: **anziani**, **persone allettate**, **utenti con disabilit\303\240 motorie o visive**, o chiunque fatichi a usare lo smartphone nel modo tradizionale."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Un progetto sviluppato da **[GlitchLab Studio](https://glitchlab.xyz)**"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "---"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## \360\237\224\222 AI Offline: sicurezza che non dipende dalla rete"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "La maggior parte delle app vocali si blocca quando manca internet.  "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "**Easy Launcher continua a funzionare.**"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Grazie a **Gemini Nano**, il modello AI integrato nel dispositivo, l\342\200\231app pu\303\262:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- avviare **chiamate vocali immediate**,  "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- eseguire **comandi essenziali**,  "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- attivare la funzione **SOS** anche senza rete,  "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- rispondere ai comandi dell\342\200\231utente con latenza minima."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Risultato: **protezione reale**, ovunque. In casa, in montagna, in viaggio, in qualsiasi situazione di emergenza."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "---"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## \360\237\247\240 Intelligenza Smart per l\342\200\231Accessibilit\303\240"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Easy Launcher \303\250 progettato per rendere lo smartphone **davvero utilizzabile** da chi ha difficolt\303\240 motorie, visive o cognitive."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### \342\234\224\357\270\217 Comandi vocali naturali  "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Parla come faresti con una persona:  "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "\342\200\234Chiama mio figlio\342\200\235, \342\200\234Apri WhatsApp\342\200\235, \342\200\234Leggi il messaggio\342\200\235."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### \342\234\224\357\270\217 Pulsanti giganti e ad alta leggibilit\303\240  "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Ogni azione importante \303\250 mostrata con pulsanti enormi, chiari e ben distanziati."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### \342\234\224\357\270\217 Lettura automatica dei messaggi  "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Grazie a ML Kit, l\342\200\231app riconosce testi, numeri e indirizzi e propone **risposte rapide** con un solo tocco."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "---"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## \360\237\221\201\357\270\217 Automazione intelligente anche nelle app difficili"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Molte app non permettono ai servizi di accessibilit\303\240 di premere i pulsanti.  "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Easy Launcher supera questo limite in modo sicuro e innovativo:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- cattura uno **screenshot invisibile**,  "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- analizza il contenuto con OCR,  "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- individua pulsanti come \342\200\234Invia\342\200\235, \342\200\234Chiama\342\200\235, \342\200\234Condividi\342\200\235,  "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- simula un tap preciso sulle coordinate corrette."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Cos\303\254 l\342\200\231utente pu\303\262 **mandare messaggi, confermare operazioni, rispondere**, anche in app non ottimizzate per l\342\200\231accessibilit\303\240."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "---"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## \360\237\232\250 Funzione SOS immediata"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "In caso di emergenza, Easy Launcher pu\303\262:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- chiamare automaticamente un numero predefinito,  "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- inviare un messaggio di aiuto,  "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- attivare la procedura **anche offline**, senza connessione."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Una protezione pensata per chi vive da solo o ha bisogno di un supporto costante."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "---"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## \360\237\216\257 Missione del progetto"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Easy Launcher vuole offrire **autonomia digitale** a chi spesso viene escluso dalla tecnologia:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- anziani,  "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- persone con disabilit\303\240 motorie,  "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- utenti allettati,  "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- persone con difficolt\303\240 visive,  "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- chiunque abbia bisogno di un\342\200\231interfaccia pi\303\271 semplice e sicura."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "---"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## \360\237\233\240\357\270\217 Tecnologie chiave"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Gemini Nano (AI offline)**  "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **AI Cloud (comandi complessi)**  "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **ML Kit (OCR, riconoscimento testo)**  "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Accessibility Services**  "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Automazione dei tap tramite coordinate**  "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "---"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## \342\235\244\357\270\217 Un progetto aperto"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Easy Launcher \303\250 in sviluppo attivo.  "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Ogni contributo \303\250 prezioso: idee, feedback, miglioramenti, test con utenti reali."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "---"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## TO-DO"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Riconoscimento e lettura ricette mediche** tramite [ML Kit Digital Ink Recognition](https://github.com/googlesamples/mlkit/tree/master/android/digitalink)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
      }
