          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        area(areaId = GridAreaNames.Area4, row = 4, column = 2)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        gap(4.dp)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    modifier = Modifier.size(360.dp)"
