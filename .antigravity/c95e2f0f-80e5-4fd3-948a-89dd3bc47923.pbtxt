          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  @InstallIn(SingletonComponent::class)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  abstract class TestModule {"
