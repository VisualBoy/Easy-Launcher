        }
        lines {
          text: "            screenshotTestImplementation(libs.screenshot.validation.api)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            screenshotTestImplementation(libs.androidx.ui.tooling)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Designate composable previews to use for screenshot tests"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "To designate the composable previews you want to use for screenshot tests, mark"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "the previews with the `@PreviewTest` annotation. The previews must be located in"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "the new `screenshotTest` source set, for example:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`app/src/screenshotTest/kotlin/com/example/yourapp/`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`ExamplePreviewScreenshotTest.kt`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "You can add more composables or previews, including multi-previews, in"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "this file or other files created in the same source set."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    package com.example.yourapp"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    import androidx.compose.runtime.Composable"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    import androidx.compose.ui.tooling.preview.Preview"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    import com.android.tools.screenshot.PreviewTest"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    import com.example.yourapp.ui.theme.MyApplicationTheme"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    @PreviewTest"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
