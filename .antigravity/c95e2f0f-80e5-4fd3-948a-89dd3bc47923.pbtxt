        }
        lines {
          text: "### Changes to `WhatsAppAccessibilityFallbackService.kt`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```kotlin"
