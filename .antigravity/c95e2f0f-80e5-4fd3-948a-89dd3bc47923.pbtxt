    source: CORTEX_STEP_SOURCE_USER_EXPLICIT
    completed_at {
      seconds: 1788915670
      nanos: 809183000
    }
  }
  file_change {
    absolute_path_uri: "file:///.agents/skills/camerax/references/modern-apis.md"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    diff {
      unified_diff {
        lines {
          text: "Always prefer these various abstractions over legacy Camera2 or early CameraX"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "implementations."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Compare APIs"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| Use case | Legacy or verbose way | Recommendation |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "|---|---|---|"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| QR or face scanning | `ImageAnalysis.Analyzer` and manual ByteBuffer math | **`MlKitAnalyzer`**, which automates coordinate mapping and multi-format support |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| Post-processing | Custom OpenGL shaders or `SurfaceTexture` | **`Media3Effect`** for composable, declarative effects |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| Dual camera | Manual binding of two UseCases | **`ConcurrentCamera`**, which provides built-in support in CameraX 1.3 and higher |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| High dynamic range | Manual bit-depth and profile config | **`DynamicRange`** , which uses `DYNAMIC_RANGE_HLG10` or `SDR` |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| Zoom and focus | `Camera2Interop` for CameraX-to-Camera2 mapping | **`CameraControl.setZoomRatio`** or **`setLinearZoom`** |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Hardware awareness"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Modern APIs abstract away the complexity of hardware diversity."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **`CameraSelector`** : Use `DEFAULT_BACK_CAMERA` or `DEFAULT_FRONT_CAMERA` instead of hardcoding camera IDs. Use `filter` if you need specific lens capabilities."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Extensions** : Before enabling advanced modes, such as night, bokeh, and face retouch, use `ExtensionsManager` to query whether the device supports them."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Foldables** : Observe `Lifecycle` and `Viewport` updates to handle posture changes, like a half-opened posture, on foldable devices."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Required dependencies"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Add the following dependencies to your `libs.versions.toml` file:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    # CameraX ML Kit"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    androidx-camera-mlkit-vision = { group = \"androidx.camera\", name ="
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    \"camera-mlkit-vision\", version.ref = \"camerax\" }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    # Media3 effects"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    androidx-media3-effect = { group = \"androidx.media3\", name = \"media3-effect\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    version.ref = \"media3\" }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    # Camera extensions"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    androidx-camera-extensions = { group = \"androidx.camera\", name ="
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    \"camera-extensions\", version.ref = \"camerax\" }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Refer to the official [CameraX Release Notes](https://developer.android.com/jetpack/androidx/releases/camera) for the"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "stable versions."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
      }
    }
  }
}
steps {
  type: CORTEX_STEP_TYPE_FILE_CHANGE
  status: CORTEX_STEP_STATUS_DONE
  metadata {
    created_at {
      seconds: 1788915670
      nanos: 809183000
    }
    source: CORTEX_STEP_SOURCE_USER_EXPLICIT
    completed_at {
      seconds: 1788915670
      nanos: 809183000
    }
  }
  file_change {
    absolute_path_uri: "file:///.agents/skills/camerax/references/testing.md"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    diff {
      unified_diff {
        lines {
          text: "Automated testing for camera features is notoriously difficult because you"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "can\'t easily mock physical hardware, lighting, or motion. This guide provides"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "patterns for reliable, hermetic camera tests."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Develop a testing mindset"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| Challenge | Conventional approach | Camera technical approach |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "|---|---|---|"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| **Frameworks** | `Mockito` or `MockK` | **Fakes over mocks** |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| **Assertions** | `assertEquals`, `assertTrue` | **Google Truth, `assertThat`** |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| **Environment** | Implied environments | **Explicit `@RunWith` annotations** |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| **Async operations** | `Thread.sleep` | **Explicit `timeoutMillis` or `IdlingResource`** |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "*** ** * ** ***"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Follow the implementation guide"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Fakes over mocks"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "**Don\'t use Mockito.** Relying on mocks for complex, rapidly changing interfaces"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "like `ImageProxy` or `CameraInfo` makes tests brittle. Instead, build \"Fake\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "implementations that verify state rather than behavior."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```kotlin"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "// Create a Fake ImageProxy for ML Testing (Fakes over Mocks)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "val fakeImage = FakeImageProxy(w = 640, h = 480)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "// Feed the fake buffer into your analyzer"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "<br />"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Mock camera capabilities"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Use `FakeAppConfig` from `androidx.camera:camera-testing` to simulate specific"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "hardware constraints in tests, such as a device without a flash."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```kotlin"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "// Use awaitInstance() extension function for coroutine-based provider retrieval"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "val cameraProvider = ProcessCameraProvider.awaitInstance(context)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "<br />"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Use Truth assertions"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Use Google Truth, `assertThat`, instead of standard JUnit assertions. It"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "provides more readable assertion chains and useful failure messages."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Test asynchronous lifecycles"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Camera initialization is asynchronous. Use `IdlingResource` to ensure"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "your test waits for the `UseCase` to be bound before asserting."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "To test asynchronous lifecycles, use the following pattern:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "1. Wrap the `ProcessCameraProvider` initialization in a `CountDownLatch` or `IdlingResource`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "2. Assert only after the `cameraControl` instance is non-null."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "*** ** * ** ***"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Testing pitfalls"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Resource leaks** : To prevent \"Camera in Use\" errors, in your `@After` block, call `cameraProvider.unbindAll`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **The \"flaky initializer\"**: Camera tests often fail on CI because the \"Virtual Camera\" takes too long to warm up. Use a sufficient explicit timeout for the first initialization."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Permission blockers** : To bypass the system permission dialogs, in your Espresso tests, use `GrantPermissionRule`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Resolution mismatch** : Tests on emulators often default to 640x480. Ensure your `ResolutionSelector` handles this low-res fallback correctly."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
      }
    }
  }
}
