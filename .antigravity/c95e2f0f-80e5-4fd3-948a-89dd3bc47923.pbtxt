      unified_diff {
        lines {
          text: "          distribution: \'temurin\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          java-version: \'17\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
