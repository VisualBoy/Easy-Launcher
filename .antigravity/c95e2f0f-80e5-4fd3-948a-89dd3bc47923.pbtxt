        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "*** ** * ** ***"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Simplify method signatures and decouple context"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Remove legacy `AppFunctionContext` parameters from your core methods. When a"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "method requires an Android `Context`, for example when constructing a"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`PendingIntent`, access `this` directly from your `AppFunctionService` wrapper"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "because the wrapper inherently extends `android.content.Context`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    -   suspend fun makeCall(appFunctionContext: AppFunctionContext, contactName: String?): PendingIntent"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
