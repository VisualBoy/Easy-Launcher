        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "This is similar to `MaterialTheme` usage APIs. It also supports multiple themes"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "as you can nest `ExtendedTheme`s in the same way as `MaterialTheme`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Use Material components"
