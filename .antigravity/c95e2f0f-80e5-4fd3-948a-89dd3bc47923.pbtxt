        }
        lines {
          text: ")"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "abstract class FakeAnalyticsModule {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  @Singleton"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  @Binds"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  abstract fun bindAnalyticsService("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
