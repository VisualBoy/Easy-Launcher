        }
        lines {
          text: "### 1. Reflection: Classes Loaded by Name"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "**Scenario:** A library or app loads a class dynamically using a string name"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Look for:**"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  `Class.forName(\"...\")`,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  `getDeclaredConstructor().newInstance()`, or interfaces used for dynamic loading."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Example Code:**"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  `kotlin"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  val taskClass = Class.forName(className)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  val task = taskClass.getDeclaredConstructor().newInstance() as StartupTask`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Suggested Keep Rule:**"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  \\`\\`\\`proguard"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  -keep class \\* implements com.example.library.StartupTask {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  (); } \\`\\`\\`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### 2. Reflection: Classes Passed using `::class.java`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "**Scenario:** An app passes a class reference directly to a library function."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Look for:** `::class.java` (Kotlin) or `.class` (Java) passed as an argument."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Example Code:**"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  `kotlin"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  fun <T> register(clazz: Class<T>) { }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // Usage:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  register(MyService::class.java)`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Suggested Keep Rule:**"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  \\`\\`\\`proguard"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  # Keep the class itself (R8 usually handles this, but explicit rules ensure stability)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  -keep class com.example.app.MyService {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  (); } \\`\\`\\`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### 3. Annotation-Based Reflection (Methods/Classes)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "**Scenario:** Using custom annotations to mark methods or classes for reflective"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "execution."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "**Look for:** Custom `@interface` definitions and `getDeclaredMethods()`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "filtered by annotation."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "**Example Code:**"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`kotlin"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "annotation class ReflectiveExecutor"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "// Logic: find methods annotated with @ReflectiveExecutor and invoke them`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Suggested Keep Rule:** \\`\\`\\`proguard # Keep the annotation itself -keep @interface com.example.library.ReflectiveExecutor"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "# Keep members of any class annotated with this specific annotation"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "-keepclassmembers class \\* {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "@com.example.library.ReflectiveExecutor \\*;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "\\`\\`\\`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### 4. Optional Dependencies (Soft Dependencies)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "**Scenario:** A core library checks if an optional module is present in the"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "classpath."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Look for:** `try-catch` blocks around `Class.forName()` used to toggle features."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Example Code:** \\`\\`\\`kotlin private const val VIDEO_TRACKER_CLASS = \"com.example.analytics.video.VideoEventTracker\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "try {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Class.forName(VIDEO_TRACKER_CLASS).getDeclaredConstructor().newInstance()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "} catch (e: ClassNotFoundException) { /\\* skip feature \\*/ }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "\\`\\`\\`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Suggested Keep Rule:** `proguard"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  # Preserve the optional class so the check doesn\'t fail due to shrinking"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  -keep class com.example.analytics.video.VideoEventTracker {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
