        }
        lines {
          text: "overrides](https://developer.android.com/static/develop/ui/compose/styles/images/basic_style_button.png) **Figure 1.** Button with two background colors set and two `contentPadding` overrides."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Merge multiple style objects"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "You can create multiple Style objects and pass them into the style parameter of"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "your composable."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
