        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    def analyze(path):"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        try:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            with open(path, \'r\') as f:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                d = json.load(f)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        except Exception as e:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            print(f\"Error loading JSON: {e}\")"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            return"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        # Build reference map"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        c_map = {c.get(\'id\'): set(c.get(\'constraints\', [])) for c in d.get(\'keep_constraints_table\', [])}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        r_map = {r.get(\'id\'): c_map.get(r.get(\'constraints_id\'), set()) for r in d.get(\'keep_rule_blast_radius_table\', [])}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        tot_opt = tot_obf = tot_shr = tot_items = 0"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        # Tally constraints across all kept items"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        for tbl in (\'kept_class_info_table\', \'kept_field_info_table\', \'kept_method_info_table\'):"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            for i in d.get(tbl, []):"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                tot_items += 1"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                kb = i.get(\'kept_by\', [])"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                if any(\'DONT_OPTIMIZE\' in r_map.get(r, set()) for r in kb): tot_opt += 1"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                if any(\'DONT_OBFUSCATE\' in r_map.get(r, set()) for r in kb): tot_obf += 1"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                if any(\'DONT_SHRINK\' in r_map.get(r, set()) for r in kb): tot_shr += 1"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        # Find denominator"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        bi = d.get(\'build_info\', {})"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        live = sum(int(bi.get(k, 0)) for k in (\'live_class_count\', \'live_field_count\', \'live_method_count\'))"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        denom = live if live > 0 else tot_items"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        # Check for globals"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        globals_src = [g.get(\'source\', \'\').lower() for g in d.get(\'global_keep_rule_blast_radius_table\', [])]"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        def score(cnt, flag):"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            if any(flag in src for src in globals_src): return 0.0"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            return max(0.0, 100.0 - ((cnt / denom * 100) if denom > 0 else 0))"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        result = ["
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
