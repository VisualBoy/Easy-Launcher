  file_change {
    absolute_path_uri: "file:///.agents/skills/appfunctions/references/feature-discovery-analysis.md"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    diff {
      unified_diff {
        lines {
          text: "Analyzes Android codebases to identify and recommend high-value AppFunctions."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Instructions"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Discover features"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "1. **Analyze manifest and entry points** : Scan `AndroidManifest.xml` and Activity, Fragment, and Service classes to identify core user journeys, for example, search, create, or share."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "2. **Identify atomic tasks**: Look for methods or logic that represent distinct, self-contained user outcomes."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "3. **Evaluate AI value**: Prioritize tasks that are frequently used or difficult to navigate using touch UI, but instead be expressed using voice or text, for example \"Remind me to call Alice when I get home.\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "4. **Recommend and justify**: List recommendations with a rationale. Focus on how an AI assistant adds value, such as efficiency, hands-free use, or multi-step automation."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Critical constraints"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Tool-first thinking"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Avoid recommending functions that are purely informational or redundant with"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "existing system actions. Focus on \"mutations\" (writing data) or \"rich queries\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "(finding specific entities)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Security and privacy"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Don\'t recommend exposing functions that handle raw credentials, financial"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "secrets, or irreversible destructive actions without explicit user confirmation"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "steps."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Examples"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Example 1: Media app discovery"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "**Recommended AppFunction** : `playArtistRadio`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "**Rationale**: Lets you start a personalized music stream using a voice"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "command, bypassing several layers of navigation in the \"Search\" and \"Artist\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "menus."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "**Input required** : `artistName` as a `String`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Example 2: Chat app contact discovery"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "**Recommended AppFunction** : `searchContacts`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "**Rationale** : Serves as a \"rich query\" to resolve a human-readable contact"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "name, email, or chat group to a unique identifier (`endpointValue`), which is a"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "prerequisite before executing actions like sending messages or"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "initiating calls. Also allows retrieving recently contacted entities when given"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "a blank query."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "**Input required** : Query as a `String`, and Filter Type as a `String`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "constrained to `\"INDIVIDUAL\"` or `\"GROUP\"`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Example 3: Chat app message sending"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "**Recommended AppFunction** : `send`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "**Rationale**: This mutation function lets you send text messages and"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "optional image attachments to a contact or group using natural language"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "commands, for example, \"Tell Alice I\'m running 5 minutes late.\" This"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "eliminates multi-step UI navigation across contact lists and conversation"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "threads."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "**Input required** : Endpoint Value as a `String`, Message Body as a `String`,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "and Image URIs as an optional `List` of URIs."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Example 4: Chat app voice calling"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "**Recommended AppFunction** : `makeCall`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "**Rationale**: Lets you initiate voice calls hands-free to a contact or"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "group using an AI agent without navigating the app\'s UI."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "**Input required** : `endpointValue` as a `String`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
      }
    }
  }
}
