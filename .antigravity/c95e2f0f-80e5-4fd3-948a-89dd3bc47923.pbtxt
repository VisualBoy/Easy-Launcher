        lines {
          text: "        live = sum(int(bi.get(k, 0)) for k in (\'live_class_count\', \'live_field_count\', \'live_method_count\'))"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        denom = live if live > 0 else sum(len(data.get(tbl, [])) for tbl in (\'kept_class_info_table\', \'kept_field_info_table\', \'kept_method_info_table\'))"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        processed = []"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        for r in data.get(\'keep_rule_blast_radius_table\', []):"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            br = r.get(\'blast_radius\', {})"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            c, f, m = len(br.get(\'class_blast_radius\', [])), len(br.get(\'field_blast_radius\', [])), len(br.get(\'method_blast_radius\', []))"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            impact = c + f + m"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            if impact == 0:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                continue"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            impact_pct = (impact / denom * 100) if denom > 0 else 0.0"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            processed.append({"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                \'id\': r.get(\'id\'),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                \'source\': r.get(\'source\'),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                \'impact\': impact,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
