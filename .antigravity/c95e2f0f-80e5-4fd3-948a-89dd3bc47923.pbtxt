          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "*** ** * ** ***"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Use Camera2 interop"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "If your app requires specific Camera2 configuration options, such as custom"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "exposure modes or flash settings, that aren\'t exposed directly in CameraX,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "use `Camera2Interop` to apply them to your CameraX use cases."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```kotlin"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "// Use Camera2Interop to set Camera2-specific capture options"
