          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Troubleshooting"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Issue: Overlay doesn\'t appear"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Check**: `SYSTEM_ALERT_WINDOW` permission granted"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Check**: `OverlayService` defined in AndroidManifest"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Check**: `overlayMain()` entry point exists in lib/overlay_main.dart"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Issue: Overlay stops responding"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Check**: Isolate crashed \342\200\224 look for `@pragma(\"vm:entry-point\")` on overlayMain()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Check**: FlutterEngine lifecycle \342\200\224 may need to call `engine.lifecycleChannel.appIsResumed()`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Issue: Screen automation fails from overlay"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Check**: AccessibilityService running and listening"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Check**: MethodChannel name matches (\"com.example.easylauncher/accessibility\")"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
