        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- \\[ \\] Does every `Activity` call `enableEdgeToEdge()`?"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- \\[ \\] Is `adjustResize` set in the `AndroidManifest.xml`?"
