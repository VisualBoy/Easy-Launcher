          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Patterns"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Service entry point pattern:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Version 1.0.0-alpha10 introduced this architectural pattern. You"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "declare `@AppFunction` methods directly inside an abstract class extending"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
