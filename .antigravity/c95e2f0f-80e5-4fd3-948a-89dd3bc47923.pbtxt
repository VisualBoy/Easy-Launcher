        }
        lines {
          text: "`app/src/screenshotTestDebug/reference`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "(`{module}/src/screenshotTest{Variant}/reference`)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "> [!NOTE]"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "> **Note:** The reference images are named with a concatenation of the fully-qualified name of the test function and a hash of the preview parameters, for example `com.sample.screenshottests.test1_da39a3ee_c2200e98_0.png`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Generate a test report"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Once the reference images exist, generate a test report by following the"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "instructions in this section for the IDE integration or for the Gradle tasks."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### In the IDE"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Click the gutter icon next to a `@PreviewTest` function and select **Run"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "\'ScreenshotTests\'**."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "If a test fails, click the test name in the **Run** panel. Select the"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "**Screenshot** tab to inspect the image diff using the integrated zoom and pan"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "controls."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "> [!NOTE]"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "> **Note:** Renaming a function annotated with `@PreviewTest` breaks the association with existing reference images. In that case, you must [regenerate reference images](https://developer.android.com/studio/preview/compose-screenshot-testing#generate-reference-images) for the new function name."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### With the Gradle tasks"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Run the validate task to take a new screenshot and compare it with the"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "reference image:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Linux and macOS: `./gradlew validateDebugScreenshotTest` (`./gradlew :{module}:validate{Variant}ScreenshotTest`)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Windows: `gradlew validateDebugScreenshotTest` (`gradlew :{module}:validate{Variant}ScreenshotTest`)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "The verification task creates an HTML report at"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`{module}/build/reports/screenshotTest/preview/{variant}/index.html`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Troubleshooting"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Compose Preview Screenshot Testing runs host-side tests, which can be"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "memory-intensive. You can increase the maximum heap size for the test JVM by"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "adding the following property to your `gradle.properties` file:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    android.compose.screenshot.maxHeapSize=4g"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Known issues"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Kotlin Multiplatform (KMP):** Both the IDE and the underlying plugin are engineered exclusively for Android projects. They don\'t support non-Android targets in KMP projects."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "You can find the complete list of current known issues in the tool\'s"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "[issue tracker component](https://issuetracker.google.com/issues?q=status:open+componentid:1581441&s=created_time:desc). Report any other feedback and issues"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "through the [issue tracker](https://issuetracker.google.com/issues/new?component=192708&template=840533)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Release updates"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "For a full list of release updates, see the"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "[release notes](https://developer.android.com/studio/preview/compose-screenshot-testing-release-notes)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
      }
    }
