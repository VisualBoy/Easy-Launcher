        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "The Styles API offers a declarative and streamlined approach to managing UI"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "changes during interaction states like `hovered`, `focused`, and `pressed`. With"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "this API, you can significantly decrease the boilerplate code typically required"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "when using modifiers."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "To facilitate reactive styling, `StyleState` acts as a stable, read-only"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "interface that tracks the active state of an element (such as its enabled,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "pressed, or focused status). Within a `StyleScope`, you can access this through"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
