    diff {
      unified_diff {
        lines {
          text: "System instructions let you give the model a persona, set the tone of its responses, or provide specific rules it must follow. These instructions are separate from the user\'s prompt and are treated with higher priority by the model to ensure it behaves as expected."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Common use cases include:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Setting a persona:** For example, \"You are a helpful math tutor.\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Enforcing output format:** For example, \"Always respond in bullet points.\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Setting constraints:** For example, \"Do not answer questions about politics.\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Prerequisites"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "System instructions work on devices running Gemini Nano V3 and higher."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Limitations"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "We don\'t recommend using system instructions with prefix caching. In general, use system instructions for short instructions that define how the model should behave; use prefix caching if you need to repeat a large part of your prompt across queries and need to optimize performance."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## How to use system instructions"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "To provide system instructions, create a `SystemInstruction` object and pass it to the `GenerateContentRequest` builder:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```kotlin"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "import com.google.mlkit.genai.prompt.SystemInstruction"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "import com.google.mlkit.genai.prompt.TextPart"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "import com.google.mlkit.genai.prompt.generateContentRequest"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "// 1. Define the system instruction"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "val systemInstruction ="
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    SystemInstruction(\"You are a concise assistant. Answer in 2 sentences or less.\")"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "// 2. Create the request"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "val request = generateContentRequest(TextPart(\"How does photosynthesis work?\")) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    this.systemInstruction = systemInstruction"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "// 3. Run inference"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "try {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    val response = generativeModel.generateContent(request)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    val text = response.candidates[0].text"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "} catch (e: Exception) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    Log.e(\"SystemInstructions\", \"Error generating content: ${e.message}\")"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
      }
    }
  }
}
