          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| `windowWidth` | [`Dp`](https://developer.android.com/reference/kotlin/androidx/compose/ui/unit/Dp) | The current window width in dp. |"
