    file_change_type: FILE_CHANGE_TYPE_CREATE
    diff {
      unified_diff {
        lines {
          text: "This page describes how to implement basic `FlexBox` layouts."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Set up project"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "1. Add the [`androidx.compose.foundation.layout`](https://developer.android.com/jetpack/androidx/versions) library to your project\'s"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "   `lib.versions.toml`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "       [versions]"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "       compose = \"1.13.0-alpha02\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "       [libraries]"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "       androidx-compose-foundation-layout = { group = \"androidx.compose.foundation\", name = \"foundation-layout\", version.ref = \"compose\" }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "2. Add the library dependency to your app\'s `build.gradle.kts`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "       dependencies {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "           implementation(libs.androidx.compose.foundation.layout)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "       }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Create basic FlexBox layouts"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "**Example 1** : `FlexBox` lays out two `Text` elements that are centrally"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "aligned."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```kotlin"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "FlexBox("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    config = {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        direction(FlexDirection.Column)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        alignItems(FlexAlignItems.Center)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: ") {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    Text(text = \"Hello\", fontSize = 48.sp)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    Text(text = \"World!\", fontSize = 48.sp)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "<br />"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "![Hello World text composables stacked on top of each other in a basic FlexBox implementation.](https://developer.android.com/static/develop/ui/compose/images/layouts/adaptive/flexbox/basic-flexbox.png)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "**Example 2** : `FlexBox` wraps five items onto two rows and grows them unequally"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "to fill the available space on each row. There is an `8.dp`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "gap, both vertically and horizontally, between the items."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```kotlin"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "FlexBox("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    config = {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        wrap(FlexWrap.Wrap)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        gap(8.dp)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: ") {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // All boxes have an intrinsic width of 100.dp"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Some grow to fill any remaining space on the row."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    RedRoundedBox()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    BlueRoundedBox()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    GreenRoundedBox(modifier = Modifier.flex { grow(1.0f) })"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    OrangeRoundedBox(modifier = Modifier.flex { grow(1.0f) })"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    PinkRoundedBox(modifier = Modifier.flex { grow(1.0f) })"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "<br />"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "![Two rows of colored items, with three unequally sized items distributed across the top row and two unequally sized items across the bottom row.](https://developer.android.com/static/develop/ui/compose/images/layouts/adaptive/flexbox/basic-flexbox-2.png)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "To learn more about `FlexBox` behavior, see [Set container behavior](https://developer.android.com/develop/ui/compose/layouts/adaptive/flexbox/container-behavior) and [Set"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "item behavior](https://developer.android.com/develop/ui/compose/layouts/adaptive/flexbox/item-behavior)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
