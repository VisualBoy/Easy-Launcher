        }
        lines {
          text: "  static Future<ChatSession?> getMostRecentSession() async {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    final sessions = await loadSessions();"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
