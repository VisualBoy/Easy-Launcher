  file_change {
    absolute_path_uri: "file:///.agents/skills/android-cli/references/journeys.md"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    diff {
      unified_diff {
        lines {
          text: "A journey is an XML-specified test of an Android app\'s behavior. It consists of a list of `<action>` elements. For example:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```xml"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "<journey name=\"My Journey\">"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "   <description>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      A sample journey to illustrate the format"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "   </description>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "   <actions>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "     <action>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "       Tap the \"Home\" icon"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "     </action>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "     <action>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "       Verify that the app is on its Home screen"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "     </action>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "   </actions>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "</journey>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Evaluate a journey by proceeding through the `<actions>` list in sequential order. Evaluate each `<action>` block individually."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "A journey succeeds if all elements in the `<actions>` list succeed."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "A journey is a test case for an app. The journey XML is the source of truth; if the app disagrees with the journey, the app has failed."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Additionally, if the app exits, crashes, or freezes, journey evaluation stops and the journey fails."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "**IMPORTANT** - Execute each step EXACTLY as written, and independently of other steps! If an action says to `\"tap the first search result\"`,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "you MUST find the search results and tap the first one. Do this even if you believe you know the intent behind the action."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Taking Actions"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Some `<action>` elements specify UI interactions to perform on the running Android app. Perform the interaction and verify that the app does "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "not crash or behave in an unexpected manner. This is the *only* verification you should perform for an `<action>`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "If the interaction cannot be performed as specified, the journey fails. "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Example: "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```<action>Click the red button</action>```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "If you determine a red button is not present in the UI, the journey fails. "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "If the text of an `<action>` specifies a list of actions, break it into sub-actions and evaluate them individually: "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Example:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```<action>Search for soda and add the first result to the cart</action>```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "This should be evaluated as:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "<action>Search for soda</action>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "<action>Add the first result to the cart</action>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "If an `<action>` contains something that is not a specification for a UI interaction, alert the user that the journey is malformed and exit"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "early, specifying the error in question."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Verifying Expectations"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`<action>` elements that begin with \"check\" or \"verify\" specify expectations for the current state of the Android app. Determine the current"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "state of the app and check if the expectations are met."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Determine the current state of the app by inspecting the current screen of the device without interacting with it."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Example:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```<action>Check if \"Switch 2\" is visible on the screen</action>```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "This requires only inspecting the current screen, not scrolling or interacting. If \"Switch 2\" is not currently visible, the action fails."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "If the expectations are not met, mark the `<action>` as a failure and the journey evaluation ends. A single `<action>` may contain"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "multiple expectations."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Example:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```<action>Verify that the app is on the Home screen, the Home icon is blue, and the temperature is displayed</action>```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "This `<action>` fails if ANY of the following are false:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- The app is on the Home screen"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- There is a Home icon, and it is blue"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- A temperature is displayed"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Handling failure "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "When running a journey, evaluate it as a test. Failure is acceptable, and often expected. Proper reporting of failures is the priority."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Keep debugging and troubleshooting to a minimum; assume that tools are showing you the correct output every time. The goal is to determine "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "if the *current* Android app can correctly handle the *current* steps outlined in the journey. Suggestions for bug fixes, clarification, or "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "other improvements should be kept to journey evaluation summary at the end."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Summarizing"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "For each `<action>` you evaluated, output JSON describing the results."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "{"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  \"journey:\", The name of the journey"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  \"results:\" ["
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      // A string containing the full text of the <action> "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \"action\": \"Click the blue button,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      // \"PASSED\" if the instruction was evaluated, \"FAILED\" if the instruction could not be evaluated, or \"SKIPPED\" if journey evaluation ended early because an instruction failed "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \"status\": \"PASSED\", "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      // A list of the ADB commands executed while evaluating the instruction,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \"commands\": [ \"adb input swipe 490 200 500 500 500\", \"adb input tap 45 920\" ],  "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      // Failure reasons, feedback, or other useful information "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \"comment\": \"The journey step doesn\'t specify that the button requires scrolling to see\", "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \"action\": \"The home screen is shown\", "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \"status\": \"FAILED\", "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \"comment\": \"The settings page was shown\",   "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  ]"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
      }
    }
  }
}
