        }
        lines {
          text: "name: android-cli"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "description: Provides instructions for installing and using the `android` CLI. The `android` command-line tool is a critical tool for Android development and helps you create new Android projects, run Android apps on devices, manage and interact with Android virtual devices (including screenshots and UI inspection), manage Android SDK components, look up official Android documentation, and discover and install official Android skills."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "license: Complete terms in LICENSE.txt"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "metadata:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  author: Google LLC"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  keywords:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - sdk"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - emulator"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - skills"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - docs"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - knowledge base"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - project creation"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - screenshots"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "---"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "# Android CLI Specialist"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "This skill provides instructions for using the `android` CLI tool. The tool includes various commands for creating projects, running applications, interacting with devices, and managing the CLI environment."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Installation"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "If the android tool is not in the path, install it. To install run the following command:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Linux: curl -fsSL https://dl.google.com/android/cli/latest/linux_x86_64/install.sh | bash"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Mac Arm: curl -fsSL https://dl.google.com/android/cli/latest/darwin_arm64/install.sh | bash"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Mac Intel: curl -fsSL https://dl.google.com/android/cli/latest/darwin_x86_64/install.sh | bash"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Windows: curl -fsSL https://dl.google.com/android/cli/latest/windows_x86_64/install.cmd -o \"%TEMP%\\i.cmd\" && \"%TEMP%\\i.cmd\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## SDK management"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "To manage the installation of Android SDKs and tools, use the `sdk` command. For example:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- `android sdk install <package>[@<version>]...`: Install specific packages. Multiple packages can be specified, separated by spaces. `<version>` defaults to latest. For example: `android sdk install platforms/android-30@2 platforms/android-34`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- `android sdk update [<pkg-name>]`: Update a specific package or all packages to the latest version."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- `android sdk remove <pkg-name>`: Remove a package from the local SDK."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- `android sdk list --all`: List installed and available SDK packages."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Project creation"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Create projects from templates using the `create` command."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "For example: `android create empty-activity --name=\"My App\" --output=./my-app`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Interacting with devices"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "For more information on interacting with running devices, see [here](references/interact.md)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Running journey tests"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "For more information on running journeys, see [here](references/journeys.md)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Doc searching"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "The `docs` command searches authoritative, high-quality Android developer documentation in the Android Knowledge Base."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "By providing a few keywords, this tool will return high quality articles that contain examples or guidance on how to use Android APIs or libraries."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Use this tool to obtain additional information on how to achieve Android-specific tasks or to know more about Android APIs, surfaces, libraries, or devices."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Always use this tool to get the most up-to-date information about Android concepts. Typical good use cases are:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - Finding migration guides for APIs."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - Finding examples for APIs."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - Finding up-to-date information about Android APIs."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - Finding best practices for Android concepts."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Running APKs"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Use the `run` command to run Android apps."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Managing emulators"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Manage Android Virtual Devices (AVDs) using the `android emulator` command"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Capturing screenshots"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Capture an image of the current screen of a connected Android device and output it to a file using the `android screenshot` command."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Managing skills"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Manage agent skills for Android using the `android skills` command."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Inspecting UI Layouts"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Use the `android layout` command to inspect the UI layout of an Android application. It returns the layout tree of an Android application in JSON format. When debugging UI errors, this is often a much faster approach than taking a screenshot."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Updating the CLI"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Update the Android CLI using the `android update` command."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "# `android help` output"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Usage: android [-hvV] [--sdk=PARAM] [COMMAND]"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  -h, --help        Show this help message and exit."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      --sdk=PARAM   Path to the Android SDK"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  -v, --verbose     Enable verbose output for troubleshooting"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  -V, --version     Print version information and exit."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Commands:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  create    Create a new Android project from available templates. Allows"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              specifying project name, output directory, minSdk, and dry-run"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              execution."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  describe  Analyzes an Android project to generate descriptive metadata."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  docs      Android documentation commands for searching and fetching developer"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              documentation from the official knowledge base."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  emulator  Manage Android Virtual Devices (AVDs). Includes commands to start,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              stop, list, and view details about emulators."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  help      Shows the help of all commands"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  info      Print environment information including SDK location, connected"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              devices, and configuration variables. Use specific fields to"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              narrow the output."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  init      Initializes the environment for the Android CLI. Sets up required"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              configurations, directories, and default skills."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  install   Install an Android Application (one or more APKs) to a connected"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              device or emulator without activating any components using"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
