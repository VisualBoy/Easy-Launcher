  file_change {
    absolute_path_uri: "file:///.agents/skills/android-intent-security/SKILL.md"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    diff {
      unified_diff {
        lines {
          text: "---"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "name: android-intent-security"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "description: Best practices for Android Intent security. Use this skill when auditing"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  component configurations in AndroidManifest.xml activities, services, receivers)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  or source code handling incoming Intents (getIntent, getParcelableExtra) to prevent"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  Intent Redirection and unauthorized access."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "license: Complete terms in LICENSE.txt"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "metadata:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  author: Google LLC"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  last-updated: \'2026-08-14\'"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  keywords:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - recipe"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - Android"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - Security"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - Intent"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - Redirection"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - PendingIntent"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - ContentProvider"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - Service"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - Signature"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - Verification"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - sanitizer"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - Vulnerability"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - Best Practices"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "---"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "This skill provides guidelines and patterns to secure Android components"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "(Activities, Services, Broadcast Receivers, Content Providers) and handle"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Intents safely, preventing privilege escalation and unauthorized access."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Glossary"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Intent:** An asynchronous messaging object used to request an action from another app component."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Exported component:** A component (`android:exported=\"true\"`) that can be launched by other apps on the device."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Sticky intent:** A broadcast intent that remains in the system cache after it\'s sent, allowing any app to retrieve its contents."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Signature permission:** A permission whose protection level is set to `signature`, granted only to apps signed with the same developer key."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **onNewIntent:** An activity lifecycle callback invoked when an activity is launched with `FLAG_ACTIVITY_SINGLE_TOP` and is already running at the top of the history stack."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **PendingIntent:** A token granted to a foreign application (for example, system services) allowing it to execute a predefined Intent with the creator\'s permissions."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Mutable PendingIntent:** A PendingIntent whose underlying Intent parameters can be modified by the receiving application."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **ContentProvider:** A component that encapsulates data and provides it to other applications via standard query/insert interfaces."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **IntentSanitizer:** A utility class in AndroidX Core used to build a safe, sanitized copy of an incoming Intent by filtering out unauthorized components, actions, or extras."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Intent redirection (forwarding):** A vulnerability where an application receives an intent from an untrusted source and uses it to launch a private, non-exported component."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Prerequisites"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- The agent **MUST** be able to describe the function and security implications of `onCreate`, `onNewIntent`, and the `singleTop` launch mode."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- The agent **MUST** be able to declare `<activity>`, `<service>`, `<receiver>`, and `<provider>` tags in `AndroidManifest.xml` and define their `android:exported` and `android:permission` attributes."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- The agent **MUST** be able to implement signature verification checks using `PackageManager`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Limitations"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- This skill focuses on local inter-component and inter-app communication security on the Android platform."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- This skill **doesn\'t** cover network security, web integration, or host-to-server security."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Setup and dependencies"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Android SDK:** Minimum API Level 23 (Android 6.0) is required for standard hardware-backed keystore operations and component validation."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
