  file_change {
    absolute_path_uri: "file:///.agents/skills/ml-kit-genai-prompt-api/references/prompt-design.md"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    diff {
      unified_diff {
        lines {
          text: "When using Prompt API, there are specific strategies you can use to tailor your prompts and receive optimal results. This page describes best practices for formatting prompts for Gemini Nano."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Prompt design best practices"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Provide examples for in-context learning:** Add well-distributed examples to your prompt to show Gemini Nano the kind of result you expect."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Be concise:** Verbose preambles with repeated instructions can produce suboptimal results. Keep your prompt focused and to-the-point."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Structure prompts:** Define instructions, constraints, and examples clearly."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Keep output short:** LLM inference speeds are heavily dependent on output length. Carefully consider generating the shortest possible output for your use case. Use Structured Output API where appropriate."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Add delimiters:** Use delimiters like `<background_information>`, `<instruction>`, and `##` to create clear separation between different parts of your prompt."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Prefer simple logic and focused tasks:** Break up complex tasks into smaller focused Gemini Nano calls chained in code."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Use lower temperature values for deterministic tasks:** For tasks such as entity extraction or translation, consider starting with temperature `0.2`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
      }
    }
  }
}
