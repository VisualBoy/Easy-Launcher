          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Architecture and versioning"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`AppFunctionServiceEntryPoint` API:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "This compile-time AppFunctions architecture was introduced in version"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "1.0.0-alpha10. You annotate a wrapper service extending"
