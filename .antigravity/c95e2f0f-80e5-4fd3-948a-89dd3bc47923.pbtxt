        }
        lines {
          text: "            }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            val continueLabel = composeTestRule.activity.getString(R.string.next)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            composeTestRule.onNodeWithText(continueLabel).performClick()"
