  file_change {
    absolute_path_uri: "file:///.agents/skills/adaptive/SKILL.md"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    diff {
      unified_diff {
        lines {
          text: "---"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "name: adaptive"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "description: Instructions to make or update an app\'s UI so that it adapts to different"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  Android devices including phones, tablets, foldables, laptops, desktop, TV, Auto"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  and XR. It includes how to handle different window sizes, pointing devices (such"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  as mouse) and text entry devices (such as keyboard) using the Compose MediaQuery"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  API. It also covers multi-pane layouts using Navigation3 Scenes, adaptive UI components"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  (such as buttons) with varying target sizes, and adaptive layouts (including navigation"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  areas - nav rails and nav bars) using the Compose Grid and FlexBox APIs."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "license: Complete terms in LICENSE.txt"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "metadata:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  author: Google LLC"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  last-updated: \'2026-08-27\'"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  keywords:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - android"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - ui"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - adaptive"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - Grid"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - FlexBox"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - MediaQuery"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - navigation"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "---"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Prerequisites"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "The app must:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Use Compose for all screens. If it\'s still using Fragments or Views, suggest using the XML to Compose skill to migrate those screens."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Use Jetpack Navigation 3. If it doesn\'t, suggest the Navigation 3 skill to migrate the app."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Workflow to make an app adaptive"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "To make an app adaptive, follow these steps or a subset of them adapting to the"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "task."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Step 1: Verify current UI"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Step 2: Make the navigation bar adaptive"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Step 3: Add multi-pane layouts"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Step 4: Make vertical lists adaptive by changing the number of columns"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Step 5: Hide app bars when scrolling"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Step 1. Verify current UI"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Ensure that screenshot tests exist to verify the current UI on different form"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "factors. If they don\'t exist, add the [Compose Preview Screenshot Testing"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "tool](references/android/develop/ui/compose/tooling/debug.md). Use the following annotation to create previews for all the major form"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "factors. For example:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```kotlin"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "@Preview(name = \"Phone\", device = Devices.PHONE, showBackground = true)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "@Preview(name = \"Foldable\", device = Devices.FOLDABLE, showBackground = true)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "@Preview(name = \"Tablet\", device = Devices.TABLET, showBackground = true)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "@Preview(name = \"Desktop\", device = Devices.DESKTOP, showBackground = true)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "annotation class FormFactorPreviews"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "@PreviewTest"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "@FormFactorPreviews"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "@Composable"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "fun FeedScreenPreview() {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    SnippetsTheme {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        Box {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            Text(\"My Screen\")"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "<br />"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Step 2. Make the navigation bar adaptive"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Bottom navigation bars are optimized for touch input when the user is holding a"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "phone in portrait mode. On larger screen hand-held devices, like tablets and"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "unfolded foldables, the navigation area must be accessible from the edge of the"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "screen (navigation rail)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "If you need to provide more screen space for the content, hide the"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "navigation area. Examples of this include:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Hiding the navigation bar when the user scrolls down and showing it again when the user scrolls up. The assumption is that when the user is scrolling down, they are consuming content but when scrolling up they are trying to navigate away from that content."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Hiding the navigation area when its content is distracting. For example, in camera previews or when displaying a full-screen photo."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "When the detail screen is displayed full-screen on mobile, full-screen mode must"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "be deactivated on larger screens."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Steps to migrate:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Locate the existing navigation bar."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Convert each item to a `NavigationSuiteItem`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Identify whether the navigation bar\'s visibility changes. For example, if it is wrapped with an `AnimatedContent` or `AnimatedVisibility` composable. If so, follow the guidance in the \"Control navigation area visibility\"."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Replace the container that held the navigation bar (often a `Scaffold`) with `NavigationSuiteScaffold` from the Material 3 adaptive layouts library."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Supply the navigation items using the `navigationItems` parameter of `NavigationSuiteScaffold`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Step 2.1. Control navigation area visibility"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "If the navigation bar\'s visibility changes - it is hidden under certain"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "scenarios or on certain screens - this behavior must be maintained with the"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "adaptive navigation area. This is done using `NavigationSuiteScaffold`\'s `state`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "parameter."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Steps to migrate:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Identify the scenarios under which the navigation bar is hidden. This is usually done with a boolean variable for the visibility. Use `isNavBarVisible` or `shouldShowNavBar` as the variable name."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Create an instance of `NavigationSuiteScaffoldState` using `rememberNavigationSuiteScaffoldState()` and pass it to `NavigationSuiteScaffold`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- When the navigation area visibility changes, use a `LaunchedEffect` to call `show` or `hide` on the `NavigationSuiteScaffoldState`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "For example:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```kotlin"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "// Pass this variable to any composable that needs to control the navigation area visibility"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "var isNavBarVisible by remember { mutableStateOf(true) }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "val scaffoldVisibilityState = rememberNavigationSuiteScaffoldState()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "NavigationSuiteScaffold("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    navigationSuiteItems = navItems,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    state = scaffoldVisibilityState"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: ") {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Main content"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "LaunchedEffect(isNavBarVisible){"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    if (isNavBarVisible) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        scaffoldVisibilityState.show()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    } else {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        scaffoldVisibilityState.hide()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "<br />"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Step 3. Add multi-pane layouts using Navigation 3 Scenes"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Analyze the codebase looking for related screens - tapping on something in one"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "screen opens another screen that shows information related to the first. There"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "are two canonical screen relationships: list-detail and supporting pane."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "IMPORTANT: You must use the Navigation 3 `SceneStrategy` approach to implement"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "multi-pane layouts. Do not use `ListDetailPaneScaffold` or"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`SupportingPaneScaffold`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Step 3.1. List-detail"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "#### Identify the list and detail screens"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "List-detail layouts display a list of items (this is the list screen) and"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "clicking on an item opens a new screen that shows more details about that item"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "(the detail screen)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Typical usage includes productivity apps like email, notes, and messaging."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Unless requested explicitly, avoid this pattern when the detail content requires"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "substantial screen space (e.g., images or media that benefits from a full-screen"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "presentation)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "#### Add a Material list-detail SceneStrategy"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Add the `androidx.compose.material3.adaptive:adaptive-navigation3` library"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Create an `androidx.compose.material3.adaptive.navigation3.ListDetailSceneStrategy` using `rememberListDetailSceneStrategy`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Pass the `ListDetailSceneStrategy` to `NavDisplay` using its `sceneStrategies` parameter"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "#### Use metadata to identify the list and detail screens"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Add metadata using `entry(metadata = ...)` or `NavEntry(metadata = ...)` to the list entry using `ListDetailSceneStrategy.listPane(detailPlaceholder = {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  <placeholder composable> })`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Use the `detailPlaceholder` parameter to add a placeholder on the detail screen when no list items are selected."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Add metadata to the detail entry using `ListDetailSceneStrategy.detailPane()`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "#### Important considerations"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- When a detail screen displays its content full-screen on mobile (content fills the entire screen, bars or rails are hidden), full-screen mode must be deactivated if it\'s part of a list-detail layout."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Detail screens must not show a back arrow when on a list-detail layout."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "For a reference implementation, check the [Nav3 **Material** List Detail"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "recipe](references/android/guide/navigation/navigation-3/recipes/material-listdetail.md)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Step 3.2. Supporting pane"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Identify supporting pane screens where a main screen displays a single item, and"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "selecting it opens a \"supporting screen\" with more details. The supporting"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "screen complements the main screen and is shown in a supporting pane."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "#### Add a Material supporting pane `SceneStrategy`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- If you haven\'t already, add the `androidx.compose.material3.adaptive:adaptive-navigation3` library"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Create an `androidx.compose.material3.adaptive.navigation3.SupportingPaneSceneStrategy` using `rememberSupportingPaneSceneStrategy`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Pass the `SupportingPaneSceneStrategy` to `NavDisplay` using its `sceneStrategies` parameter"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "#### Use metadata to identify the main and supporting screens"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Add metadata using `entry(metadata = ...)` or `NavEntry(metadata = ...)` to the main entry using `SupportingPaneSceneStrategy.mainPane()`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Add metadata to the supporting entry using `SupportingPaneSceneStrategy.supportingPane()`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Step 3.3. Run screenshot tests"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "If you have made changes, record new reference files. Ask the user to visually"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "verify that the new layouts are correct."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Step 4. Make vertical lists adaptive by changing the number of columns"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Step 4.1. Make lazy lists adaptive"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Look for the following vertical list composables: `LazyColumn`,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`LazyVerticalGrid`, `LazyVerticalStaggeredGrid`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Steps to migrate:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Choose a suitable minimum width in dp for the column. The item must be clearly visible to the user at this width."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- For `LazyColumn`: change to a `LazyVerticalGrid` and follow the instruction later"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- For `LazyVerticalGrid`: change the `columns` parameter to use `GridCells.Adaptive(<width>.dp)`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- For `LazyVerticalStaggeredGrid`: change the `columns` parameter to use `StaggeredGridCells.Adaptive(<width>.dp)`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Step 4.2. Migrate non-lazy lists to Grid"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "WARNING: Grid is an experimental API available from Compose 1.11.0-beta01."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Confirm with the user that they are happy to use an experimental API in their"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "codebase."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Look for any `Column` that contains multiple items of the same type and replace"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "it with `Grid`. Do not replace it with `LazyVerticalGrid` or any other lazy"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "layout. Do not place `Grid` inside the existing `Column`. Completely replace it."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`Grid` is configured by supplying a lambda (an extension function on"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`GridConfigurationScope`) to its `config` parameter. Inside the lambda,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`constraints` provides the minimum and maximum dimensions of the grid container"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "and can be used to change the number of rows and columns based on the available"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "size. For example, the following code configures `Grid` such that when the"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "available width is:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- less than 800dp, a 2x4 grid is used"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- 800dp or more, a 4x2 grid is used"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```kotlin"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Grid("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    config = {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        val maxWidthDp = constraints.maxWidth.toDp()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        val (cols, rows) = if (maxWidthDp < 800.dp){"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            2 to 4"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        } else{"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            4 to 2"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        val gapSizeDp = 8.dp"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        val cellSize = ((maxWidthDp - (gapSizeDp * (cols - 1))) / cols).coerceAtLeast(0.dp)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        repeat(cols) { column(cellSize) }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        repeat(rows) { row(cellSize) }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        gap(gapSizeDp)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: ") { /** items **/ }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "<br />"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`Grid` is an experimental API so add the `@OptIn(ExperimentalGridApi::class)`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "annotation to any function that uses it."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Step 5: Hide App Bars when scrolling"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "In an app with multiple top-level destinations, each screen must manage its own"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "app bar state independently. There are two main scroll behaviors:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- `exitUntilCollapsedScrollBehavior`: Hides on scroll down, stays hidden while you scroll up until you reach the very top (0 offset)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- `enterAlwaysScrollBehavior`: Hides on scroll down, shows immediately on scroll up."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Final step: Build and test"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Build the app and run the local tests. If the project has screenshot tests, run"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "them but DO NOT update the reference images. Prompt the user to do this after"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "they have viewed the screenshot diffs."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Additional documentation for experimental adaptive APIs"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "The following APIs are available from Compose 1.11.0-beta01."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### FlexBox"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Check the FlexBox documentation:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- [Overview](references/android/develop/ui/compose/layouts/adaptive/flexbox/index.md)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- [Get started - setup](references/android/develop/ui/compose/layouts/adaptive/flexbox/get-started.md)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- [Set container behavior](references/android/develop/ui/compose/layouts/adaptive/flexbox/container-behavior.md)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- [Set item behavior](references/android/develop/ui/compose/layouts/adaptive/flexbox/item-behavior.md)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## MediaQuery"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Check the [MediaQuery documentation](references/android/develop/ui/compose/layouts/adaptive/mediaquery/index.md) when you need to query the device\'s"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "screen size, pointer precision, keyboard type, whether it has cameras or"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "microphones, and other device capabilities."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Grid"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Check the Grid documentation when you need to display a fixed number of items in"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "a grid layout:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- [Overview](references/android/develop/ui/compose/layouts/adaptive/grid/index.md)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- [Get started - setup](references/android/develop/ui/compose/layouts/adaptive/grid/get-started.md)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- [Set container properties](references/android/develop/ui/compose/layouts/adaptive/grid/container-properties.md)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- [Set item properties](references/android/develop/ui/compose/layouts/adaptive/grid/item-properties.md)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
      }
    }
  }
}
