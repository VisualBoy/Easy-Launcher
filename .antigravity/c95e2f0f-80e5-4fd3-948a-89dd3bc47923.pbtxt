        }
        lines {
          text: "Some foldables allow using the rear camera with the cover display while the"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "device is unfolded."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Verification:** If available through OEM SDKs or Android 14 (API level 34) or higher, check `DeviceState.REAR_DISPLAY_STATE`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Logic:** Handle preview detachment and reattachment on different display surfaces with varying aspect ratios."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "*** ** * ** ***"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Foldable pitfalls"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Hinge distortion:** Don\'t span the camera preview across a hinge in `HALF_OPENED` state."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Physical orientation:** The camera sensor\'s physical orientation relative to the screen often changes when you fold or unfold the device. Always rely on `CameraInfo.getSensorRotationDegrees`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Latency:** Rebinding `UseCase` objects during a fold event is expensive. Use the internal scaling of `PreviewView` before performing a full `bindToLifecycle` reconfiguration."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
      }
    }
  }
}
