        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "For the best user experience, you should optimize your app to make it as small"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "and fast as possible. Our app optimizer, called R8, streamlines your app by"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
