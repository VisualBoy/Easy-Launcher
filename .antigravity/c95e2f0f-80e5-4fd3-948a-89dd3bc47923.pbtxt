          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Overview"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "**private-agent** separates concerns into two layers:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "1. **Kotlin Native Layer** (`AgentAccessibilityService.kt`) \342\200\224 Direct Android Accessibility API access"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "2. **Dart/Flutter Layer** (`ScreenAutomationService.dart`) \342\200\224 Clean async API for business logic"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "This enables:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- \342\234\205 **Testable Dart code** \342\200\224 Mock the MethodChannel"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- \342\234\205 **Type-safe async/await** \342\200\224 No callback hell"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- \342\234\205 **Single source of truth** \342\200\224 One place to manage all accessibility calls"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- \342\234\205 **Easy AI integration** \342\200\224 Feed screen data directly to LLM"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "---"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
