        }
        lines {
          text: "2. **Week 2**: Create `ScreenAutomationService.dart`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "   - Dart wrapper around MethodChannel"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
