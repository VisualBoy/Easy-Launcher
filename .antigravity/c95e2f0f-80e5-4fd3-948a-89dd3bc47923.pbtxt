  file_change {
    absolute_path_uri: "file:///.agents/skills/r8-analyzer/references/android/training/testing/other-components/ui-automator.md"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    diff {
      unified_diff {
        lines {
          text: "The UI Automator testing framework provides a set of APIs to build UI tests that"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "interact with user apps and system apps."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "> [!NOTE]"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "> **Note:** This documentation covers the modern approach to writing UI Automator tests, introduced with [UI Automator 2.4](https://developer.android.com/jetpack/androidx/releases/test-uiautomator#2.4.0). This approach makes your tests more concise, readable, and robust. The API is under development, and we strongly recommend using it for any new development with UI Automator. The [legacy API guidance](https://developer.android.com/training/testing/other-components/ui-automator-legacy) is also available."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Introduction to modern UI Automator testing"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "UI Automator 2.4 introduces a streamlined, Kotlin-friendly Domain Specific"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Language (DSL) that simplifies writing UI tests for Android. This new API"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "surface focuses on predicate-based element finding and explicit control over app"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "states. Use it to create more maintainable and reliable automated tests."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "UI Automator lets you test an app from outside of the app\'s process. This"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "lets you test release versions with minification applied. UI Automator also"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "helps when writing macrobenchmark tests."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Key features of the modern approach include:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- A dedicated `uiAutomator` test scope for cleaner and more expressive test code."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Methods like `onElement`, `onElements`, and `onElementOrNull` for finding UI elements with clear predicates."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Built-in waiting mechanism for conditional elements `onElement*(timeoutMs:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  Long = 10000)`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Explicit app state management such as `waitForStable` and `waitForAppToBeVisible`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Direct interaction with accessibility window nodes for multi-window testing scenarios."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Built-in screenshot capabilities and a `ResultsReporter` for visual testing and debugging."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Set up your project"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "To begin using the modern UI Automator APIs, update your project\'s"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`build.gradle.kts` file to include the [latest dependency](https://developer.android.com/jetpack/androidx/releases/test-uiautomator#2.4.0):"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Kotlin"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    dependencies {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      ..."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      androidTestImplementation(\"androidx.test.uiautomator:uiautomator:2.4.0-alpha05\")"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Groovy"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    dependencies {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      ..."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      androidTestImplementation \"androidx.test.uiautomator:uiautomator:2.4.0-alpha05\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Core API concepts"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "The following sections describe core concepts of the modern UI Automator API."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### The uiAutomator test scope"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Access all new UI Automator APIs within the **`uiAutomator { ... }`**"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "block. This function creates a `UiAutomatorTestScope` that provides a concise"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "and type-safe environment for your test operations."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    uiAutomator {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      // All your UI Automator actions go here"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      startApp(\"com.example.targetapp\")"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      onElement { textAsString() == \"Hello, World!\" }.click()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Find UI elements"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Use UI Automator APIs with predicates to locate UI elements. These predicates"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "let you define conditions for properties such as text, selected or focused"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "state, and content description."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- `onElement { predicate }`: Returns the first UI element that matches the"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  predicate within a default timeout. The function throws an exception if it"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  doesn\'t locate a matching element."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      // Find a button with the text \"Submit\" and click it"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      onElement { textAsString() == \"Submit\" }.click()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      // Find a UI element by its resource ID"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      onElement { viewIdResourceName == \"my_button_id\" }.click()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      // Allow a permission request"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      watchFor(PermissionDialog) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        clickAllow()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- `onElementOrNull { predicate }`: Similar to `onElement`, but returns"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  `null` if the function finds no matching element within the timeout. It"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  doesn\'t throw an exception. Use this method for optional elements."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      val optionalButton = onElementOrNull { textAsString() == \"Skip\" }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      optionalButton?.click() // Click only if the button exists"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- `onElements { predicate }`: Waits until at least one UI element matches"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  the given predicate, then returns a list of all matching UI elements."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      // Get all items in a list Ui element"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      val listItems = onElements { className == \"android.widget.TextView\" && isClickable }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      listItems.forEach { it.click() }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Here are some tips for using `onElement` calls:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Chain `onElement` calls for nested elements: You can chain `onElement`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  calls to find elements within other elements, following a parent-child"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  hierarchy."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      // Find a parent Ui element with ID \"first\", then its child with ID \"second\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      // then its grandchild with ID \"third\", and click it."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      onElement { viewIdResourceName == \"first\" }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        .onElement { viewIdResourceName == \"second\" }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        .onElement { viewIdResourceName == \"third\" }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        .click()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Specify a timeout for `onElement*` functions by passing a value representing"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  milliseconds."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      // Find a Ui element with a zero timeout (instant check)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      onElement(0) { viewIdResourceName == \"something\" }.click()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      // Find a Ui element with a custom timeout of 10 seconds"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      onElement(10_000) { textAsString() == \"Long loading text\" }.click()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Interact with UI elements"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Interact with UI elements by simulating clicks or setting text in editable"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "fields."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Click a Ui element"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    onElement { textAsString() == \"Tap Me\" }.click()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Set text in an editable field"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    onElement { className == \"android.widget.EditText\" }.setText(\"My input text\")"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Perform a long click"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    onElement { contentDescription == \"Context Menu\" }.longClick()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Handle app states and watchers"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Manage the lifecycle of your app and handle unexpected UI elements that might"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "appear during your tests."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### App lifecycle management"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "The APIs provide ways to control the state of the app under test:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Start a specific app by package name. Used for benchmarking and other"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // self-instrumenting tests."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    startApp(\"com.example.targetapp\")"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Start a specific activity within the target app"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    startActivity(SomeActivity::class.java)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Start an intent"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    startIntent(myIntent)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Clear the app\'s data (resets it to a fresh state)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    clearAppData(\"com.example.targetapp\")"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Handle unexpected UI"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "The `watchFor` API lets you define handlers for unexpected UI elements,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "such as permission dialogs, that might appear during your test flow. This"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "uses the internal watcher mechanism but offers more flexibility."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    import androidx.test.uiautomator.PermissionDialog"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    @Test"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    fun myTestWithPermissionHandling() = uiAutomator {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      startActivity(MainActivity::class.java)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      // Register a watcher to click \"Allow\" if a permission dialog appears"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      watchFor(PermissionDialog) { clickAllow() }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      // Your test steps that might trigger a permission dialog"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      onElement { textAsString() == \"Request Permissions\" }.click()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      // Example: You can register a different watcher later if needed"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      clearAppData(\"com.example.targetapp\")"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      // Now deny permissions"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      startApp(\"com.example.targetapp\")"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      watchFor(PermissionDialog) { clickDeny() }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      onElement { textAsString() == \"Request Permissions\" }.click()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`PermissionDialog` is an example of a `ScopedWatcher<T>`, where `T` is the"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "object passed as a scope to the block in `watchFor`. You can create custom"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "watchers based on this pattern."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Wait for app visibility and stability"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Sometimes tests need to wait for elements to become visible or stable."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "UI Automator offers several APIs to help with this."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "The `waitForAppToBeVisible(\"com.example.targetapp\")` waits for a UI element with"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "the given package name to appear on the screen within a customizable timeout."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Wait for the app to be visible after launching it"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    startApp(\"com.example.targetapp\")"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    waitForAppToBeVisible(\"com.example.targetapp\")"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Use the `waitForStable()` API to verify that the app\'s UI is considered stable"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "before interacting with it."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Wait for the entire active window to become stable"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    activeWindow().waitForStable()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Wait for a specific Ui element to become stable (e.g., after a loading animation)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    onElement { viewIdResourceName == \"my_loading_indicator\" }.waitForStable()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "> [!NOTE]"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "> **Note:** In most cases, `waitForStable()` isn\'t strictly necessary when using `onElement { ... }` because `onElement` already includes a timeout. Use `waitForStable()` primarily in combination with `onElements { ... }` to verify that all UI elements are visible, when you know that the UI is in an unstable state, or for specific screenshot testing scenarios where you need the UI to completely settle before capturing. `waitForStable()` works by waiting until no changes are detected in the accessibility tree for a set period. Note that this UI stability check doesn\'t guarantee that the app is fully idle, as background tasks might still be running."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Use UI Automator for Macrobenchmarks and Baseline Profiles"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Use UI Automator for performance testing with [Jetpack Macrobenchmark](https://developer.android.com/topic/performance/benchmarking/macrobenchmark-overview)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "and for generating [Baseline Profiles](https://developer.android.com/topic/performance/baselineprofiles/overview), as it provides a reliable way to"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "interact with your app and measure performance from an end-user perspective."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Macrobenchmark uses UI Automator APIs to drive the UI and measure interactions."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "For example, in startup benchmarks, you can use `onElement` to detect when UI"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "content is fully loaded, enabling you to measure [Time to Full Display"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "(TTFD)](https://developer.android.com/topic/performance/vitals/launch-time#time-full). In jank benchmarks, UI Automator APIs are used to scroll lists or"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "run animations to measure frame timings. Functions like `startActivity()` or"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`startIntent()` are useful for getting the app into the correct state before"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "measurement begins."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "When [generating Baseline Profiles](https://developer.android.com/topic/performance/baselineprofiles/create-baselineprofile), you automate your app\'s critical user"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "journeys (CUJs) to record which classes and methods require pre-compilation. UI"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Automator is an ideal tool for writing these automation scripts. The modern"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "DSL\'s predicate-based element finding and built-in wait mechanisms (`onElement`)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "lead to more robust and deterministic test execution compared to other methods."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "This stability reduces flakiness and ensures that the generated Baseline Profile"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "accurately reflects the code paths executed during your most important user"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "flows."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Advanced features"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "The following features are useful for more complex testing scenarios."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Interact with multiple windows"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "The UI Automator APIs let you directly interact with and inspect UI"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "elements. This is particularly useful for scenarios involving multiple windows,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "such as Picture-in-Picture (PiP) mode or split-screen layouts."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Find the first window that is in Picture-in-Picture mode"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    val pipWindow = windows()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      .first { it.isInPictureInPictureMode == true }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Now you can interact with elements within that specific window"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    pipWindow.onElement { textAsString() == \"Play\" }.click()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Screenshots and visual assertions"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Capture screenshots of the entire screen, specific windows, or"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "individual UI elements directly within your tests. This is helpful for visual"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "regression testing and debugging."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    uiautomator {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      // Take a screenshot of the entire active window"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      val fullScreenBitmap: Bitmap = activeWindow().takeScreenshot()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      fullScreenBitmap.saveToFile(File(\"/sdcard/Download/full_screen.png\"))"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      // Take a screenshot of a specific UI element (e.g., a button)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      val buttonBitmap: Bitmap = onElement { viewIdResourceName == \"my_button\" }.takeScreenshot()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      buttonBitmap.saveToFile(File(\"/sdcard/Download/my_button_screenshot.png\"))"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      // Example: Take a screenshot of a PiP window"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      val pipWindowScreenshot = windows()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        .first { it.isInPictureInPictureMode == true }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        .takeScreenshot()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      pipWindowScreenshot.saveToFile(File(\"/sdcard/Download/pip_screenshot.png\"))"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "The `saveToFile` extension function for Bitmap simplifies saving the captured"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "image to a specified path."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Use ResultsReporter for debugging"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "The `ResultsReporter` helps you associate test artifacts, like screenshots,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "directly with your test results in Android Studio for easier inspection and"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "debugging."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    uiAutomator {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      startApp(\"com.example.targetapp\")"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      val reporter = ResultsReporter(\"MyTestArtifacts\") // Name for this set of results"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      val file = reporter.addNewFile("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        filename = \"my_screenshot\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        title = \"Accessible button image\" // Title that appears in Android Studio test results"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      )"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      // Take a screenshot of an element and save it using the reporter"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      onElement { textAsString() == \"Accessible button\" }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        .takeScreenshot()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        .saveToFile(file)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      // Report the artifacts to instrumentation, making them visible in Android Studio"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      reporter.reportToInstrumentation()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Migrate from older UI Automator versions"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "If you have existing UI Automator tests written with older API surfaces, use the"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "following table as a reference to migrate to the modern approach:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| Action type | Old UI Automator method | New UI Automator method |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "|---|---|---|"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| Entry point | `UiDevice.getInstance(InstrumentationRegistry.getInstrumentation())` | Wrap test logic in the `uiAutomator { ... }` scope. |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| Find UI elements | `device.findObject(By.res(\"com.example.app:id/my_button\"))` | `onElement { viewIdResourceName == \"my\\_button\" }` |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| Find UI elements | `device.findObject(By.text(\"Click Me\"))` | `onElement { textAsString() == \"Click Me\" }` |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| Wait for idle UI | `device.waitForIdle()` | Prefer `onElement`\'s built-in timeout mechanism; otherwise, `activeWindow().waitForStable()` |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| Find child elements | Manually nested `findObject` calls | `onElement().onElement()` chaining |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| Handle permission dialogs | `UiAutomator.registerWatcher()` | `watchFor(PermissionDialog)` |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
      }
    }
  }
}
