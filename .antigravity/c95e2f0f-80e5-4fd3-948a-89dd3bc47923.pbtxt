          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Because composables typically consume these dependencies indirectly through a"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "ViewModel obtained with `hiltViewModel()`, replacing the binding in Hilt is"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "enough. The composable under test picks up the fake automatically."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "#### Replace a binding in a single test"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "To replace a binding in a single test instead of all tests, uninstall a Hilt"
