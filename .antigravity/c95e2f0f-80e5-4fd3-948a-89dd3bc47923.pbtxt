  file_change {
    absolute_path_uri: "file:///.agents/skills/appfunctions/references/migrate-to-service-entry-point.md"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    diff {
      unified_diff {
        lines {
          text: "Follow this systematic procedure to migrate Android applications that use the"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "AppFunctions API in version 1.0.0-alpha09 and lower to the compile-time"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`@AppFunctionServiceEntryPoint` architecture introduced in version"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`1.0.0-alpha10`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "*** ** * ** ***"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Architectural shift overview"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "In lower versions of the AppFunctions API, for example version `1.0.0-alpha09`:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Applications require separate dependencies for core functionality, specifically `androidx.appfunctions:appfunctions`, and service components, specifically `androidx.appfunctions:appfunctions-service`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- The application implements `AppFunctionConfiguration.Provider` on its `Application` class."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- You manually register enclosing class instantiation using `AppFunctionConfiguration.Builder().addEnclosingClassFactory(...)`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- You place metadata property tags directly under `<application>`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "In version `1.0.0-alpha10` featuring `@AppFunctionServiceEntryPoint`:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- The core and service dependencies are consolidated into a single runtime artifact, `androidx.appfunctions:appfunctions`, which eliminates the need for the standalone `appfunctions-service` library."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- A dedicated wrapper class extending `AppFunctionService` is annotated with `@AppFunctionServiceEntryPoint` and Hilt\'s `@AndroidEntryPoint` or an alternative dependency injection framework."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- The KSP compiler generates a concrete service subclass and an XML metadata schema file in `assets/`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- The OS discovers and routes executions using a consolidated `<service>` and `app_metadata` declaration in `AndroidManifest.xml`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Strict migration requirements from 1.0.0-alpha09 to 1.0.0-alpha10"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "When focusing solely on the mandatory API changes required by the new"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`@AppFunctionServiceEntryPoint` architecture, the migration consists of four"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "strict requirements that you must complete:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "1. **Build dependency consolidation** : Remove the merged `appfunctions-service` dependency while retaining core `appfunctions` and the KSP compiler."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "2. **Service wrapper creation** : Replace the legacy `AppFunctionConfiguration.Provider` on the `Application` class with an abstract class extending `AppFunctionService`, annotated with `@AppFunctionServiceEntryPoint`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "3. **Annotation and context decoupling** : Move `@AppFunction` annotations to the new wrapper methods and drop `AppFunctionContext` parameters because `AppFunctionService` inherits directly from `Context`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "4. **Manifest registration** : Register the KSP-generated concrete service in `AndroidManifest.xml` with `BIND_APP_FUNCTION_SERVICE`, the `AppFunctionService` intent filter, and metadata property tags."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "*** ** * ** ***"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Systematic migration steps"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Consolidate AppFunctions build dependencies"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Remove the standalone `appfunctions-service` library from your module build"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "files like `build.gradle.kts` and version catalog like `libs.versions.toml`. In"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "version `1.0.0-alpha10`, all core service capabilities are consolidated directly"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "within the main `appfunctions` artifact."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // build.gradle.kts"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    dependencies {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        implementation(libs.androidx.appfunctions)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    -   implementation(libs.androidx.appfunctions.service)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        ksp(libs.androidx.appfunctions.compiler)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    # libs.versions.toml"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    [versions]"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    appfunctions = \"1.0.0-alpha10\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    [libraries]"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    androidx-appfunctions = { module = \"androidx.appfunctions:appfunctions\", version.ref = \"appfunctions\" }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    -   androidx-appfunctions-service = { module = \"androidx.appfunctions:appfunctions-service\", version.ref = \"appfunctions\" }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    androidx-appfunctions-compiler = { module = \"androidx.appfunctions:appfunctions-compiler\", version.ref = \"appfunctions\" }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "> [!NOTE]"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "> **Note:** If another dependency in your project uses snapshot builds like `1.0.0-SNAPSHOT` or custom snapshot repositories from `https://androidx.dev/snapshots/...`, preserve your custom snapshot repository configuration in `settings.gradle.kts`. Otherwise, standard Google Maven repositories resolve `1.0.0-alpha10` directly."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "*** ** * ** ***"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Create a dedicated wrapper service extending `AppFunctionService`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Instead of annotating standalone business logic classes or implementing manual"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "configuration providers, create an abstract service wrapper across your project,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "for example `BaseAppFunctionService`, extending `AppFunctionService` and"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "annotated with `@AppFunctionServiceEntryPoint`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "#### Recommended approach using Hilt"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Annotate your service with `@AndroidEntryPoint` and inject your data"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "repositories or use cases using standard `@Inject internal lateinit var`:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```kotlin"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "@RequiresApi(36)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "@AndroidEntryPoint"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "@AppFunctionServiceEntryPoint("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    serviceName = \"MyAppFunctionService\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    appFunctionXmlFileName = \"my_app_function_service\", // Do NOT include .xml extension"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: ")"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "abstract class BaseAppFunctionService : AppFunctionService() {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    @Inject internal lateinit var messageRepository: MessageRepository"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    @AppFunction(isDescribedByKDoc = true)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    internal suspend fun send("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        name: String,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        endpointValue: String,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        messageBody: String,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    ): MessageResult {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        return messageRepository.send(name, endpointValue, messageBody)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "<br />"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "#### Framework-agnostic approach using alternative dependency injection or a service locator"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "While Hilt is recommended, many Android applications implement AppFunctions with"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "alternative dependency injection frameworks like Koin, Anvil, or manual Service"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Locators. Because `AppFunctionService` inherits from Android"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`android.app.Service` and therefore `Context`, you are able access your"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "application\'s DI container directly through `applicationContext` in property"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "getters or during service lifecycle execution:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```kotlin"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "@RequiresApi(36)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "@AppFunctionServiceEntryPoint("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    serviceName = \"ServiceLocatorMyAppFunctionService\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    appFunctionXmlFileName = \"service_locator_my_app_function_service\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: ")"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "abstract class ServiceLocatorBaseAppFunctionService : AppFunctionService() {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Example using a manual Service Locator or Application container"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    private val messageRepository by lazy {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        (applicationContext as AppFunctionApplication).appContainer.messageRepository"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
