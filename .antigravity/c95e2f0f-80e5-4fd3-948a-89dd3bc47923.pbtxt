          text: "We recommend that you access values you set from your custom theme."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Alternatively, if your theme doesn\'t provide `Color`, `TextStyle`, `Shape`, or"
