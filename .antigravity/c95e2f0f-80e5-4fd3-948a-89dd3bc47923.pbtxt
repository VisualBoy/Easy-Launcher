          text: "       val buttonStyle: Style = Style {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "           shape(shapes.medium)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "           background(colors.brand)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
