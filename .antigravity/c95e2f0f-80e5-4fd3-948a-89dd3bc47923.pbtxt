    file_change_type: FILE_CHANGE_TYPE_CREATE
    diff {
      unified_diff {
        lines {
          text: "This guide covers implementing low-light features using **Night mode"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "extensions** and **Low Light Boost (LLB)**."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Choosing the right tool"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| Feature | Used for | Implementation | UX impact |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "|---|---|---|---|"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| **Night mode** | High-quality stills | `ExtensionsManager` | Possibly requires user to hold still for several seconds. |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| **LLB, AE mode** | Real-time preview or video | `Camera2Interop`, CameraX utility | Hardware drops the frame rate to increase brightness. |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| **LLB, Play services** | Real-time preview and video | `SurfaceProcessor` | Software-based brightening; maintains a higher frame rate. |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "*** ** * ** ***"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Night mode extension"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "CameraX Extensions provide access to the device\'s built-in computational"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "photography pipeline."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Basic setup"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "To set up the extension, initialize the extension manager:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```kotlin"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "// Use ListenableFuture.await() extension function for coroutine support"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "val extensionsManager = ExtensionsManager.getInstanceAsync(context, cameraProvider).await()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "if (extensionsManager.isExtensionAvailable(cameraSelector, ExtensionMode.NIGHT)) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    val nightSelector = extensionsManager.getExtensionEnabledCameraSelector("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        cameraSelector, ExtensionMode.NIGHT"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    )"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    cameraProvider.bindToLifecycle(lifecycleOwner, nightSelector, imageCapture, preview)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "<br />"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Comprehensive features"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Image postview** : Display a low-resolution image immediately while the multi-frame processing occurs."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  ```kotlin"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  val imageCapture = ImageCapture.Builder()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      .setPostviewEnabled(true)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      .build()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  ```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Extension strength** : Let users control the intensity of the night effect."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  ```kotlin"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // Set the strength of the active extension (e.g. NIGHT mode intensity)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  val extensionsManager = ExtensionsManager.getInstanceAsync(context, cameraProvider).await()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  val extensionsControl = extensionsManager.getCameraExtensionsControl(camera.cameraControl)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  extensionsControl?.setExtensionStrength(strength)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  ```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Capture progress** : Show a UI progress bar for long exposures."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  ```kotlin"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // Use the suspend extension function for takePicture to avoid callback boilerplate"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  try {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      val result = imageCapture.takePicture(outputOptions)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      // Use result.savedUri or other fields"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  } catch (e: ImageCaptureException) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      // Handle capture failure"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  ```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "*** ** * ** ***"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Low-light boost"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "LLB is designed for preview and video streams where you prefer high frame rates."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### AE mode"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "The built-in CameraX way to prioritize brightness. It modifies the hardware\'s"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "auto-exposure algorithm."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Activation** : Use `CameraControl.enableLowLightBoostAsync`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Implementation** :"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  ```kotlin"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // Enable Low Light Boost (LLB) natively in CameraX 1.4+"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  camera.cameraControl.enableLowLightBoostAsync(true)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  ```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Monitoring** : Observe `CameraInfo.lowLightBoostState` to track when the hardware actively applies the enhancement."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Google Play services LLB"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "It\'s a multi-step implementation that uses a session-based `SurfaceProcessor`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "**Dependency** : `com.google.android.gms:play-services-camera-low-light-boost`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "To implement Google Play services LLB, follow these core steps:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "1. **Initialize client** : `val client = LowLightBoost.getClient`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "2. **Implement `SurfaceProcessor`** :"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "   - **Manage session** : Call `client.createSession`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "   - **Forward required metadata** : Observe the camera\'s `TotalCaptureResult` stream and forward every result to the session: `session.processCaptureResult`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "   - **Provide surface** : Get the input surface from the session, `session.getCameraSurface`, and provide it to the camera\'s `SurfaceRequest`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "   - **Lifecycle** : Release the session, `session.release`, when the processor is closed or the `SurfaceRequest` completes."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "3. **Wire using `CameraEffect`** :"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "   ```kotlin"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "   val effect = SimpleCameraEffect("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "       CameraEffect.PREVIEW or CameraEffect.VIDEO_CAPTURE,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "       executor,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "       llbSurfaceProcessor"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "   ) { throw it }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "   // Add to UseCaseGroup"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "   val useCaseGroup = UseCaseGroup.Builder()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "       .addUseCase(preview)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "       .addUseCase(videoCapture)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "       .addEffect(effect)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "       .build()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "   ```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "4. **Scene detection** : Use `session.setSceneDetectorCallback` to receive `boostStrength` updates for real-time UI indicators."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "*** ** * ** ***"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Implementation notes"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Thread safety** : Always handle `ExtensionsManager` and `LowLightBoostClient` initialization asynchronously."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **FPS trade-offs**: AE mode LLB often drops the frame rate significantly to increase brightness."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Compatibility** : Extensions, Night Mode, possibly conflict with `ConcurrentCamera`. Always verify support before binding."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
      }
    }
  }
}
steps {
  type: CORTEX_STEP_TYPE_FILE_CHANGE
  status: CORTEX_STEP_STATUS_DONE
  metadata {
    created_at {
      seconds: 1788915670
      nanos: 809183000
    }
    source: CORTEX_STEP_SOURCE_USER_EXPLICIT
    completed_at {
      seconds: 1788915670
      nanos: 809183000
    }
  }
  file_change {
    absolute_path_uri: "file:///.agents/skills/camerax/references/mlkit-spatial.md"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    diff {
      unified_diff {
        lines {
          text: "When you use ML Kit for features such as face mesh, object detection, or pose"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "detection, the most common failure point is the coordinate disparity between the"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "analysis image and the viewfinder UI."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## The mapping mindset"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| Dimension | Analysis frame | Viewfinder UI on the screen |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "|---|---|---|"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| Resolution | Fixed, such as 640x480 | Dynamic, such as 1080x2400 |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| Rotation | 0\302\260 for the raw buffer | 90\302\260 or 270\302\260 in portrait or landscape mode |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| Origin | Top-left of buffer at (0,0) | Top-left of screen at (0,0) |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "*** ** * ** ***"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Follow the implementation guide"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Coordinate transformation matrix"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Android provides the `Viewport` and `UseCaseGroup` APIs to calculate the"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "transformation matrix automatically. **Don\'t** calculate aspect ratio scaling"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "manually."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```kotlin"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "val transform = previewView.viewPort?.let { viewPort ->"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Use CameraX\'s built-in coordinate mapper"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    viewPort.getTransformationMatrix(imageProxy.imageInfo.rotationDegrees)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "<br />"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Handling the \"double rotation\" bug"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "ML Kit results, bounding boxes, are relative to the **rotated buffer**. If the"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "device is in portrait, the buffer is often 480x640, landscape, but the screen"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "is 1080x1920."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "To map the coordinates, use the following workflow:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "1. Query `imageProxy.imageInfo.rotationDegrees`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "2. Pass this rotation to the ML Kit `InputImage`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "3. Use the `MappingUtils.transformRect` method to map the result `Rect` to the screen."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Face mesh and pose normalization"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "For high-precision spatial analysis, for example, \"Is the user\'s hand at a"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "specific screen button?\", use **normalized coordinates from 0.0 to 1.0**."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```kotlin"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "// Example: Converting a Pose landmark to a Screen Coordinate"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "val screenX = landmark.position.x / analysisWidth * screenWidth"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "val screenY = landmark.position.y / analysisHeight * screenHeight"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "<br />"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "**Warning** : Always account for **mirrored lenses** . If the `LENS_FACING_FRONT`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "is used, you must flip the X-coordinate: `actualX = screenWidth - screenX`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Overlays and canvas clipping"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Use a custom `GraphicOverlay` view on top of the `PreviewView`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Buffer lock** : Ensure your `GraphicOverlay` clears its canvas every time a new `ImageAnalysis` frame is processed to prevent \"ghosting\" of bounding boxes."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "*** ** * ** ***"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Spatial pitfalls"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **The \"stretched box\" bug** : Caused by assuming the Analysis Frame aspect ratio, 4:3, matches the screen aspect ratio, 21:9. Use `PreviewView.SCALE_TYPE_FILL_CENTER` and map coordinates accordingly."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Latency** : If ML processing exceeds 50 ms, the bounding box trails behind the user\'s face."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - **Fix** : Use `ImageAnalysis.STRATEGY_KEEP_ONLY_LATEST` to avoid queuing stale frames."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Sensor vs. display rotation** : On some tablets, the sensor is mounted horizontally. Always query `display.rotation` and `cameraInfo.sensorRotationDegrees`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
      }
    }
  }
}
steps {
  type: CORTEX_STEP_TYPE_FILE_CHANGE
  status: CORTEX_STEP_STATUS_DONE
  metadata {
    created_at {
      seconds: 1788915670
      nanos: 809183000
