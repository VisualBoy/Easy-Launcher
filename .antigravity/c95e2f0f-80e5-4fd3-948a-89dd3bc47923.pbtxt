        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Identify the keep rules with the highest impact and the subsumed rules using the"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
