          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Next, configure this test runner in your Gradle file as described in the"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "[instrumented unit test"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
