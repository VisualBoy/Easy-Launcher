  file_change {
    absolute_path_uri: "file:///.agents/skills/camerax/references/immutability.md"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    diff {
      unified_diff {
        lines {
          text: "Many Android APIs are designed with immutability in mind to prevent race"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "conditions in async environments. However, this often trips up developers used"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "to mutable builder patterns."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Common immutable classes"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "The following classes use fluent APIs that **return a new instance**. You must"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "reassign the variable."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| Class | Methods that return a new instance | Result if not reassigned |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "|---|---|---|"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| `PendingRecording` | `withAudioEnabled`, `asPersistentRecording` | Audio isn\'t recorded. |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| `ImageCapture.Builder` | `setTargetRotation`, `setTargetResolution` | The output has the wrong orientation. |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| `Recorder.Builder` | `setQualitySelector`, `setExecutor` | The recording uses the default quality. |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "| `Viewport.Builder` | `setScaleType`, `setLayoutDirection` | The viewfinder is stretched. |"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Use standard patterns"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### CameraX video recording"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "To set up video recording, use the following code:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```kotlin"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "// WRONG"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "run {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  val pending = recorder.prepareRecording(context, opts)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  pending.withAudioEnabled() // This returns a new instance which is ignored"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  val active = pending.start(exec, listener)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "// CORRECT"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "run {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  val pending = recorder.prepareRecording(context, opts)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      .withAudioEnabled() // Chaining works"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  val active = pending.start(exec, listener)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "// ALSO CORRECT"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "run {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  var pending = recorder.prepareRecording(context, opts)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  pending = pending.withAudioEnabled() // Reassignment"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  val active = pending.start(exec, listener)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "<br />"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Viewport construction"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "To set up the viewport, use the following code:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```kotlin"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "val viewport = ViewPort.Builder(Rational(width, height), displayRotation)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    .setScaleType(ViewPort.FILL_CENTER)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    .build()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
