        lines {
          text: "## Custom state styling with StyleState"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Depending on your composable use case, you may have different styles that are"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "backed by custom states. For example, if you have a media app, you may want to"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "have different styling for the buttons in your `MediaPlayer` composable"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "depending on the playback state of the player. Follow these steps to create and"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
