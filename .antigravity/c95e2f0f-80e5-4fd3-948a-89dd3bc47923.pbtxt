          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      - name: Setup Gradle"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        uses: gradle/actions/setup-gradle@v4"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        with:"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          gradle-version: \'9.3.1\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      - name: Generate Debug Keystore"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        run: |"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          mkdir -p ~/.android"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "          if [ ! -f ~/.android/debug.keystore ]; then"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "            keytool -genkey -v -keystore ~/.android/debug.keystore -storepass android -alias androiddebugkey -keypass android -keyalg RSA -keysize 2048 -validity 10000 -dname \"CN=Android Debug,O=Android,C=US\""
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "          if [ ! -f \"debug.keystore\" ]; then"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            keytool -genkey -v -keystore debug.keystore -storepass android -alias androiddebugkey -keypass android -keyalg RSA -keysize 2048 -validity 10000 -dname \"CN=Android Debug,O=Android,C=US\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          fi"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      - name: Build Debug APK"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        run: gradle :app:assembleDebug --stacktrace --no-daemon"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      - name: Verify Debug APK"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        run: |"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
