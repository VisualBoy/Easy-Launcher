        }
        lines {
          text: "#### Replace a binding"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "If you need to inject a fake or mock instance of a dependency, you need to tell"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Hilt not to use the binding that it used in production code and to use a"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "different one instead. To replace a binding, you need to replace the module that"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "contains the binding with a test module that contains the bindings that you want"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "to use in the test."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "For example, suppose your production code declares a binding for"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`AnalyticsService` as follows:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```kotlin"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "@Module"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "@InstallIn(SingletonComponent::class)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "abstract class AnalyticsModule {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  @Singleton"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  @Binds"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  abstract fun bindAnalyticsService("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    analyticsServiceImpl: AnalyticsServiceImpl"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  ): AnalyticsService"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "To replace the `AnalyticsService` binding in tests, create a new Hilt module in"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "the `test` or `androidTest` folder with the fake dependency and annotate it"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "with `@TestInstallIn`. All the tests in that folder are injected with the fake"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "dependency instead."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```kotlin"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "@Module"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "@TestInstallIn("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    components = [SingletonComponent::class],"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    replaces = [AnalyticsModule::class]"
