        }
        lines {
          text: "metadata:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  author: Google LLC"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  last-updated: \'2026-08-24\'"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  keywords:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - android"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - compose"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - system bars"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - edge-to-edge"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - status bar"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - navigation bar"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "---"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Prerequisites"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Project **MUST** use Android Jetpack Compose."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- Project **MUST** target SDK 35 or later. If the SDK is lower than 35, increase the SDK to 35."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Step 1: plan"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "1. Locate and analyze all Activity classes to detect which have existing edge-to-edge support. For every Activity without edge-to-edge, plan to make each Activity edge-to-edge."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "2. In each Activity, Locate and analyze all lists and FAB components to detect which have existing edge-to-edge support. For every component without edge-to-edge support, plan to make each of these components edge-to-edge."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "3. In each Activity, scan for `TextField`, `OutlinedTextField`, or `BasicTextField`. If found, then you **MUST** verify the IME doesn\'t hide the input field by following the IME section of this skill."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Step 2: add edge-to-edge support"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "1. Add `enableEdgeToEdge` before `setContent` in `onCreate` in each Activity that does not already call `enableEdgeToEdge`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "2. Add `android:windowSoftInputMode=\"adjustResize\"` in the AndroidManifest.xml for all Activities that use a soft keyboard."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Step 3: apply insets"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- The app **MUST** apply system insets, or align content to rulers, so critical"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  UI remains tappable. Choose only one method to avoid double padding:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  1. **PREFERRED:** When available, use `Scaffold`s and pass `PaddingValues` to the content lambda."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  ```kotlin"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  Scaffold { innerPadding ->"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      // innerPadding accounts for system bars and any Scaffold components"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      LazyColumn("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          modifier = Modifier"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              .fillMaxSize()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              .consumeWindowInsets(innerPadding),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          contentPadding = innerPadding"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      ) { /* Content */ }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  ```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  <br />"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  1. **PREFERRED:** When available, use the automatic inset handling or padding modifiers in material components."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "     - Material 3 Components manages safe areas for its own components, including:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "       - `TopAppBar`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "       - `SmallTopAppBar`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "       - `CenterAlignedTopAppBar`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "       - `MediumTopAppBar`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "       - `LargeTopAppBar`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "       - `BottomAppBar`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "       - `ModalDrawerSheet`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "       - `DismissibleDrawerSheet`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "       - `PermanentDrawerSheet`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "       - `ModalBottomSheet`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "       - `NavigationBar`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "       - `NavigationRail`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "     - For Material 2 Components, use the `windowInsets`parameter to apply insets manually for `BottomAppBar`, `TopAppBar` and `BottomNavigation`. **DO NOT** apply padding to the parent container; instead, pass insets directly to the App Bar component. Applying padding to the parent container prevents the App Bar background from drawing into the system bar area. For example, for `TopAppBar`, choose only one of the following options:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "       1. **PREFERRED:** `TopAppBar(windowInsets = AppBarDefaults.topAppBarWindowInsets)`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "       2. `TopAppBar(windowInsets = WindowInsets.systemBars.exclude(WindowInsets.navigationBars))`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "       3. `TopAppBar(windowInsets = WindowInsets.systemBars.add(WindowInsets.captionBar))`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  2. For components outside a Scaffold, use padding modifiers, such as `Modifier.safeDrawingPadding()` or `Modifier.windowInsetsPadding(WindowInsets.safeDrawing)`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "     ```kotlin"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "     Box("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "         modifier = Modifier"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "             .fillMaxSize()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "             .safeDrawingPadding()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "     ) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "         Button("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "             onClick = {},"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "             modifier = Modifier.align(Alignment.BottomCenter)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "         ) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "             Text(\"Login\")"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "         }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "     }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "     ```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "     <br />"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  3. For deeply nested components with excessive padding, use `WindowInsetsRulers` (e.g. `Modifier.fitInside(WindowInsetsRulers.SafeDrawing.current)`). See the *IME* section for a code sample."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  4. When you need an element (e.g. a custom header or decorative scrim) to"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "     equal the dimensions of a system bar, use inset size modifiers (e.g."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "     `Modifier.windowInsetsTopHeight(WindowInsets.systemBars)`)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "     See the *Lists* section for a code sample."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## Adaptive Scaffolds"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- `NavigationSuiteScaffold` manages safe areas for its own components, like the `NavigationRail` or `NavigationBar`. However, the adaptive scaffolds (e.g. `NavigationSuiteScaffold`, `ListDetailPaneScaffold`) don\'t propagate PaddingValues to their inner contents. You **MUST** apply insets to **individual** screens or components (e.g., list `contentPadding` or FAB padding) as described in *Step 3* . **DO NOT** apply `safeDrawingPadding` or similar modifiers to the `NavigationSuiteScaffold` parent. This clips and prevents an edge-to-edge screen."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## IME"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- For each Activity with a soft keyboard, check that `android:windowSoftInputMode=\"adjustResize\"` is set in the AndroidManifest.xml. DO NOT use `SOFT_INPUT_ADJUST_RESIZE` because it is deprecated. Then, maintain focus on the input field. Choose one:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - 1. **PREFERRED:** Add `Modifier.fitInside(WindowInsetsRulers.Ime.current)` to the content container. This is preferred over `imePadding()` because it reduces jank and extra padding caused by forgetting to consume insets upstream in the hierarchy."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  - 2. Add `imePadding` to the content container. The padding modifier **MUST** be placed before `Modifier.verticalScroll()`. Do NOT use `Modifier.imePadding()` if the parent already accounts for the IME with `contentWindowInsets` (e.g. `contentWindowInsets ="
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    WindowInsets.safeDrawing`). Doing so will cause double padding."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### IMEs with Scaffolds code patterns"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "#### RIGHT"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "RIGHT because `contentWindowInsets` contains IME insets, which are passed to the"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "content lambda as `innerPadding`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```kotlin"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "// RIGHT"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Scaffold(contentWindowInsets = WindowInsets.safeDrawing) { innerPadding ->"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    Column("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        modifier = Modifier"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            .padding(innerPadding)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            .consumeWindowInsets(innerPadding)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            .verticalScroll(rememberScrollState())"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    ) { /* Content */ }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "<br />"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "*** ** * ** ***"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "RIGHT because `fitInside` fits the content to the IME insets regardless of"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`contentWindowInsets`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```kotlin"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "// RIGHT"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Scaffold() { innerPadding ->"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    Column("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        modifier = Modifier"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            .padding(innerPadding)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            .consumeWindowInsets(innerPadding)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            .fitInside(WindowInsetsRulers.Ime.current)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
