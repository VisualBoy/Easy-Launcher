    diff {
      unified_diff {
        lines {
          text: "To achieve maximum utilization of R8, the codebase must be configured correctly"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "depending on the build script language (Kotlin DSL versus Groovy DSL)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## 1. App Modules (`com.android.application`)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "The app\'s `build.gradle` or `build.gradle.kts` file must enable minification"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "and resource shrinking within the `release` build type or the apps custom build"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "type for release and performance testing. It MUST use the optimized default file"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "(`proguard-android-optimize.txt`)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "**Kotlin DSL (`build.gradle.kts`):**"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    buildTypes {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "       getByName(\"release\") {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "           isMinifyEnabled = true"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "           isShrinkResources = true"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "           proguardFiles("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "               getDefaultProguardFile(\"proguard-android-optimize.txt\"),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "               \"proguard-rules.pro\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "           )"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "       }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "**Groovy DSL (`build.gradle`):**"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    buildTypes {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "       release {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "           minifyEnabled = true"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "           shrinkResources = true"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "           proguardFiles getDefaultProguardFile(\'proguard-android-optimize.txt\'), \'proguard-rules.pro\'"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "       }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "## 2. `gradle.properties` Flags"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "**Full Mode:** R8 Full Mode enables the entire optimizations"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **AGP 8.0+** : Enabled by default. Ensure `android.enableR8.fullMode=false` is **NOT** present."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "- **Pre-AGP 8.0** : Explicitly enable with `android.enableR8.fullMode=true`."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "**Optimized Resource Shrinking:** If the AGP version of the project is less than"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "9.0 and more than 8.6, explicitly enable the new resource shrinker:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    android.r8.optimizedResourceShrinking=true"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
      }
    }
  }
