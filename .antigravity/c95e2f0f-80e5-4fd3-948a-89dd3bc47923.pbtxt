        }
        lines {
          text: "```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "<br />"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "> [!IMPORTANT]"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "> **Important:** Unlike modifier-based styling, properties in Styles override one another; the last property defined takes precedence."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Properties in Styles are not additive, unlike modifier-based styling. Styles"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "take the last set value in the list of properties within one style block. In the"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "following example, with the background set twice, the `TealColor` is the applied"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "background. For padding, `contentPaddingTop` overrides the top"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "padding set by `contentPadding` and does not combine the values."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "```kotlin"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "BaseButton("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    style = {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        background(Color.Red)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        // Background of Red is now overridden with TealColor instead"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        background(TealColor)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        // All directions of padding are set to 64.dp (top, start, end, bottom)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        contentPadding(64.dp)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        // Top padding is now set to 16.dp, all other paddings remain at 64.dp"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        contentPaddingTop(16.dp)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    onClick = {"
