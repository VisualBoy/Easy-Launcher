          text: "               },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "           )"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "           .styleable(styleState, JetsnackTheme.styles.buttonStyle, style)) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "           Text(text)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "       }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "   }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "   ```"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "   <br />"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Beyond global theme adoption, there are alternative strategies for incorporating"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`Styles` into your apps. You can use `Styles` inline for specific call sites or"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "use static definitions when full theming capabilities aren\'t necessary."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`Styles` shouldn\'t be swapped conditionally unless the whole style is"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "fundamentally different. Prefer accessing dynamic tokens inside a visual"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "definition rather than switching between distinct style objects."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
      }
    }
  }
}
steps {
  type: CORTEX_STEP_TYPE_FILE_CHANGE
  status: CORTEX_STEP_STATUS_DONE
  metadata {
    created_at {
      seconds: 1788915670
