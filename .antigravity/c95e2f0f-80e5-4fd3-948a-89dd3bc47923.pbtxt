          text: "       androidx-navigationevent-compose = { module = \"androidx.navigationevent:navigationevent-compose\", version.ref = \"navigationevent\" }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "2. Update your compile SDK to 36 or above:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "       [versions]"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "       compileSdk = \"36\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "3. Add the following to your app build file, `app/build.gradle.kts`:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
