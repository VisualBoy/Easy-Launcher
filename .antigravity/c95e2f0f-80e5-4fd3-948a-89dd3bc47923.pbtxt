          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Grid("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    config = {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        repeat(2) {"
